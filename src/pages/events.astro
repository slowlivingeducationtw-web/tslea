---
import Base from '../layouts/Base.astro'
import EventCard from '../components/EventCard.astro'
import { getEvents } from '../lib/events'
import { fetchOne, Q } from '../lib/sanity'
import FormatList from '../components/FormatList.astro'
import { getSettings, getThemes, getActivityTypes, typeTone } from '../lib/site'

// 全站唯一的活動清單；首頁「近期活動」只是這裡「即將舉行／持續進行」的前三筆
// 頁面文字在後台「頁面文案 → 活動」，活動本身在「內容 → 活動資訊」
// 一個活動一頁：清單是全部活動，還沒結束的在前、已結束（含活動回顧）的在後
const { list } = await getEvents()
type Page = {
  title: string
  lead?: string
  seoDescription?: string
  facebookNote?: boolean
  currentTitle?: string
  emptyText?: string
}
// 「學會活動類別」（後台「內容 → 學會活動類別」）是活動的分類標籤，
// 下方清單可以依類別篩選（/events?type=…）。
const [page, settings, learning, types] = await Promise.all([
  fetchOne<Page>(Q.eventsPage, {}, '活動頁面'),
  getSettings(),
  getThemes(),
  getActivityTypes(),
])


---
<Base
  title={page.title}
  description={page.seoDescription}
>
  <div class="page" id="page-events">
    <header class="page-head">
      <div class="container">
        <p class="crumbs"><a href="/">首頁</a> / {page.title}</p>
        <h1>{page.title}</h1>
        <p class="lead">
          {page.lead}
          {page.facebookNote && settings.facebook && (
            <>最新消息也可以關注學會的
            <a class="text-link" href={settings.facebook} target="_blank" rel="noopener">Facebook 粉絲專頁</a>。</>
          )}
        </p>
      </div>
    </header>

    {types.length ? (
      <section class="block" id="types" aria-labelledby="types-title">
        <div class="container">
          <h2 id="types-title" class="block-title events-h">{learning.formatsTitle || '學會活動'}</h2>
          <FormatList formats={types} />
        </div>
      </section>
    ) : null}


    {types.length > 0 && (
      <nav class="type-filter" id="list" aria-label="依活動類別篩選">
        <div class="container type-filter-inner">
          <span class="type-filter-label">依類別看活動</span>
          <button type="button" class="type-btn is-on" data-type="" aria-pressed="true">全部</button>
          {types.map((t) => (
            <button type="button" class={`type-btn tone-${typeTone(types, t.slug)}`} data-type={t.slug} aria-pressed="false">{t.title}</button>
          ))}
        </div>
      </nav>
    )}

    <section class="block block-alt filterable" id="current" aria-labelledby="current-title">
      <div class="container">
        <h2 id="current-title" class="block-title events-h">{page.currentTitle || '活動一覽'}</h2>
        {list.length > 0 ? (
          <div class="grid-3">{list.map((e) => <EventCard event={e} />)}</div>
        ) : (
          <p class="events-empty">{page.emptyText || '目前沒有公告中的活動，新活動會公布在這裡。'}</p>
        )}
        <p class="events-empty filter-empty" hidden>這個類別目前還沒有活動。</p>
      </div>
    </section>


  </div>

  <script>
    // 依活動類別篩選：上方按鈕、「學會活動」的圖示、網址 ?type=… 三種方式都會套用
    const btns = [...document.querySelectorAll<HTMLButtonElement>('.type-btn')]
    function apply(type: string) {
      btns.forEach((b) => {
        const on = b.dataset.type === type
        b.classList.toggle('is-on', on)
        b.setAttribute('aria-pressed', String(on))
      })
      document.querySelectorAll<HTMLElement>('.filterable').forEach((sec) => {
        const items = [...sec.querySelectorAll<HTMLElement>('[data-type]')]
        let shown = 0
        items.forEach((el) => {
          const hit = !type || el.dataset.type === type
          ;(el.closest('li, .grid-3 > *') as HTMLElement ?? el).hidden = !hit
          if (hit) shown++
        })
        const none = !!type && shown === 0
        // 「即將舉行」留著並說明沒有；回顧與已辦理沒有符合的就整區收起，避免一長串「沒有」
        if (sec.id === 'current') {
          const empty = sec.querySelector<HTMLElement>('.filter-empty')
          if (empty) empty.hidden = !(none && items.length > 0)
        } else sec.hidden = none
      })
      const url = new URL(location.href)
      if (type) url.searchParams.set('type', type)
      else url.searchParams.delete('type')
      history.replaceState(null, '', url)
    }
    btns.forEach((b) => b.addEventListener('click', () => apply(b.dataset.type ?? '')))
    // 同一頁的「學會活動」圖示：直接篩選並捲到清單，不重新載入
    document.querySelectorAll<HTMLAnchorElement>('.format-link').forEach((a) =>
      a.addEventListener('click', (ev) => {
        ev.preventDefault()
        apply(a.dataset.type ?? '')
        document.getElementById('list')?.scrollIntoView({ behavior: 'smooth' })
      }),
    )
    const want = new URLSearchParams(location.search).get('type')
    if (want && btns.some((b) => b.dataset.type === want)) apply(want)
  </script>
</Base>

<style>
  .events-h { margin-bottom: 2rem; }
  .events-empty { font-size: 1rem; color: var(--ink-soft); line-height: 1.9; }
</style>
