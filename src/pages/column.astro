---
// 慢活專欄列表：版型與活動頁一致（頁首→分類篩選→卡片）。
// 上方文字在後台「頁面文案 → 慢活專欄」，文章在「內容 → 專欄文章」。
import Base from '../layouts/Base.astro'
import PortableText from '../components/PortableText.astro'
import ArticleCard from '../components/ArticleCard.astro'
import { fetchOne, Q } from '../lib/sanity'
import { CATEGORIES, getArticles } from '../lib/column'

type Page = { title: string; lead?: string; seoDescription?: string; emptyText?: any[] }
const [articles, page] = await Promise.all([getArticles(), fetchOne<Page>(Q.columnPage, {}, '慢活專欄頁面')])
// 篩選按鈕只列有文章的分類，避免點了是空的
const used = CATEGORIES.filter((c) => articles.some((a) => a.category === c.value))
---
<Base title={page.title} description={page.seoDescription}>
  <div class="page" id="page-column">
    <header class="page-head">
      <div class="container">
        <p class="crumbs"><a href="/">首頁</a> / {page.title}</p>
        <h1>{page.title}</h1>
        {page.lead && <p class="lead">{page.lead}</p>}
      </div>
    </header>

    {used.length > 1 && (
      <nav class="type-filter" id="list" aria-label="依分類篩選文章">
        <div class="container type-filter-inner">
          <span class="type-filter-label">依分類看文章</span>
          <button type="button" class="type-btn is-on" data-type="" aria-pressed="true">全部</button>
          {used.map((c) => (
            <button type="button" class="type-btn" data-type={c.value} aria-pressed="false">{c.label}</button>
          ))}
        </div>
      </nav>
    )}

    <section class="block block-alt" aria-label="文章列表">
      <div class="container">
        {articles.length > 0 ? (
          <div class="grid-3" id="posts">{articles.map((a) => <ArticleCard article={a} />)}</div>
        ) : null}
        <div class="col-empty rich-links" id="colEmpty" hidden={articles.length > 0}>
          {page.emptyText ? <PortableText value={page.emptyText} /> : <p>這個分類目前還沒有文章。</p>}
        </div>
      </div>
    </section>
  </div>

  <script>
    // 依分類篩選：按鈕或網址 ?cat=…（首頁主題、選單子項目會用這種網址連進來）
    const btns = [...document.querySelectorAll<HTMLButtonElement>('.type-btn')]
    const cards = [...document.querySelectorAll<HTMLElement>('#posts > [data-type]')]
    const empty = document.getElementById('colEmpty')
    function apply(cat: string) {
      btns.forEach((b) => {
        const on = b.dataset.type === cat
        b.classList.toggle('is-on', on)
        b.setAttribute('aria-pressed', String(on))
      })
      let shown = 0
      cards.forEach((c) => {
        c.hidden = !!cat && c.dataset.type !== cat
        if (!c.hidden) shown++
      })
      if (empty) empty.hidden = shown > 0
      const url = new URL(location.href)
      if (cat) url.searchParams.set('cat', cat)
      else url.searchParams.delete('cat')
      history.replaceState(null, '', url)
    }
    btns.forEach((b) => b.addEventListener('click', () => apply(b.dataset.type ?? '')))
    const want = new URLSearchParams(location.search).get('cat')
    if (want) apply(want)
  </script>
</Base>

<style>
  .col-empty { padding: 2rem 0; text-align: center; font-size: 1rem; line-height: 2; color: var(--ink-soft); }
</style>
