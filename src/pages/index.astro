---
import Base from '../layouts/Base.astro'
import PortableText from '../components/PortableText.astro'
import { sanity, fetchOne, Q } from '../lib/sanity'

type Home = {
  eyebrow?: string
  headlineBefore?: string
  headlineAccent?: string
  headlineAfter?: string
  subheadEn?: string
  lead?: string
  heroTags?: string[]
  aboutLabel?: string
  aboutTitle?: string
  aboutBody?: any
  eventsLabel?: string
  eventsTitle?: string
}
type Event = {
  title: string
  dateLabel: string
  icon?: string
  description?: string
  tag?: string
  showInMarquee?: boolean
  showAsCard?: boolean
}

const home = await fetchOne<Home>(Q.home, {}, '首頁文案')
const events = await sanity.fetch<Event[]>(Q.events)

const marquee = events.filter((e) => e.showInMarquee !== false)
const cards = events.filter((e) => e.showAsCard !== false)

// 卡片色塊循環，維持原本三張卡片的配色變化
const GRADIENTS = [
  'linear-gradient(135deg,#c8d4bc,#a8b89a)',
  'linear-gradient(135deg,#d4c4a8,#c8a878)',
  'linear-gradient(135deg,#b8ccd8,#8aaac0)',
]

const marqueeItems = marquee.map((e) => `${e.dateLabel} ${e.title}`)
---
<Base
  title="臺灣慢活教育學會｜慢下來，才看得見生活"
  description="臺灣慢活教育學會以身心健康、藝術陪伴、生態永續三大共學主題，推廣慢活教育與終身學習。立案於苗栗，歡迎認同理念的朋友一起放慢腳步。"
>
  <div class="page" id="page-home">
    <!-- HERO -->
    <div class="hero">
      <div class="hero-left">
        {home.eyebrow && <p class="hero-year">{home.eyebrow}</p>}
        <h1 class="hero-title">
          {home.headlineBefore}<em>{home.headlineAccent}</em><br />{home.headlineAfter}
        </h1>
        {home.subheadEn && <p class="hero-en">{home.subheadEn}</p>}
        {home.lead && (
          <p class="hero-tagline" style="white-space:pre-line">{home.lead}</p>
        )}
        {home.heroTags && home.heroTags.length > 0 && (
          <div class="hero-pills">
            {home.heroTags.map((t) => <span class="pill">{t}</span>)}
          </div>
        )}
        <div class="hero-cta">
          <a class="btn-primary" href="/column">閱讀慢活專欄</a>
          <a class="btn-text" href="#about-sec">了解學會 →</a>
        </div>
      </div>
      <div class="hero-right">
        <div class="hero-visual"></div>
        <div style="position:absolute;inset:0">
          <div class="circle c1"></div><div class="circle c2"></div><div class="circle c3"></div>
        </div>
        <div class="hero-kanji">慢</div>
      </div>
    </div>

    <!-- ABOUT -->
    <section class="sec" id="about-sec" style="background:var(--cream)">
      <div class="about-grid">
        <div>
          {home.aboutLabel && <p class="sec-label">{home.aboutLabel}</p>}
          <h2 class="sec-title">{home.aboutTitle}</h2>
          <div class="about-deco">慢活</div>
        </div>
        <div class="about-text">
          <PortableText value={home.aboutBody} />
        </div>
      </div>
    </section>

    <!-- EVENTS -->
    <section class="sec" id="events-sec" style="background:var(--warm-white);padding-bottom:0">
      {home.eventsLabel && <p class="sec-label">{home.eventsLabel}</p>}
      <h2 class="sec-title">{home.eventsTitle}</h2>

      {marqueeItems.length > 0 && (
        <div style="background:var(--sage);overflow:hidden;margin-bottom:3rem;padding:0.65rem 0">
          <div class="marquee-track">
            <span class="marquee-text">
              {/* 重複兩輪，讓跑馬燈接得上 */}
              {[...marqueeItems, ...marqueeItems].map((t) => (
                <span style="margin-right:2.5rem">✦ {t}</span>
              ))}
            </span>
          </div>
        </div>
      )}

      {cards.length > 0 && (
        <div style={`display:grid;grid-template-columns:repeat(${Math.min(cards.length, 3)},1fr);gap:2px;margin:0 -5rem`}>
          {cards.map((e, i) => (
            <div class="event-card">
              <div class="event-photo" style={`background:${GRADIENTS[i % GRADIENTS.length]}`}>
                <div class="event-photo-inner">{e.icon}</div>
              </div>
              <div class="event-body">
                <div class="event-date">{e.dateLabel}</div>
                <div class="event-title">{e.title}</div>
                {e.description && <p class="event-desc">{e.description}</p>}
                {e.tag && <span class="event-tag">{e.tag}</span>}
              </div>
            </div>
          ))}
        </div>
      )}
    </section>
  </div>
</Base>
