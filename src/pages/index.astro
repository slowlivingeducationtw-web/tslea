---
import Base from '../layouts/Base.astro'
import PortableText from '../components/PortableText.astro'
import Photo from '../components/Photo.astro'
import HeroCarousel, { type HeroSlide } from '../components/HeroCarousel.astro'
import EventCard from '../components/EventCard.astro'
import FormatList from '../components/FormatList.astro'
import { fetchOne, imageUrl, Q } from '../lib/sanity'
import { youtubeId } from '../lib/video'
import { getEvents } from '../lib/events'
import { getThemes, getActivityTypes, themeTone, headlineHtml, highlightHtml, isExternal, type Link } from '../lib/site'

// 版面參考 TFT（teach4taiwan.org）的敘事方式：
// 置中主視覺 → 一句主張＋說明（認識學會）→ 編號敘事「我們怎麼一起學」→ 近期活動
// → 大圖入口 → 滿版行動呼籲。
// 所有文字與照片都在後台編輯：「首頁」「首頁・慢活共學」「認識學會」「活動資訊」。

type Img = { asset?: any; alt?: string }
type Home = {
  heroSlides?: {
    _key: string; pre?: string; title: string; sub?: string; image?: Img; tone?: HeroSlide['tone']
    video?: { url?: string; start?: number; end?: number }
  }[]
  statement?: string
  statementHighlight?: string
  eventsTitle?: string
  eventsSub?: string
  tilesTitle?: string
  tiles?: { _key: string; title: string; text?: string; href: string; image?: Img; tone?: string }[]
  ctaTitle?: string
  ctaText?: string
  ctaButtons?: Link[]
  seoTitle?: string
  seoDescription?: string
}
const [home, learning, about, activityTypes] = await Promise.all([
  fetchOne<Home>(Q.home, {}, '首頁'),
  getThemes(),
  fetchOne<{ body?: any[] }>(Q.aboutPage, {}, '認識學會頁面'),
  getActivityTypes(),
])

// 「近期活動」是 /events 活動清單的前三筆（還沒結束的優先，不夠時補上最近的回顧），不另外維護一份
const events = (await getEvents()).list.slice(0, 3)

// 「認識學會」右欄取「認識學會」頁學會簡介的前兩段，完整內容在 /about
const aboutIntro = (about.body ?? []).filter((b) => b._type === 'block').slice(0, 2)

// 字數多的大標用小一號字級，避免手機上排成很多行
const plainLen = (t: string) => t.replace(/\s/g, '').length
const slides: HeroSlide[] = (home.heroSlides ?? []).map((s) => ({
  pre: s.pre,
  title: headlineHtml(s.title),
  size: plainLen(s.title) > 12 ? 'md' : 'lg',
  sub: s.sub,
  tone: s.tone ?? 'forest',
  image: imageUrl(s.image, 2000) ?? null,
  imageAlt: s.image?.alt || s.title.replace(/\s+/g, ''),
  video: youtubeId(s.video?.url) ? { id: youtubeId(s.video!.url)!, start: s.video!.start ?? 0, end: s.video!.end } : undefined,
}))

const themes = learning.themes ?? []

const ext = (href: string) => (isExternal(href) ? { target: '_blank', rel: 'noopener' } : {})
---
<Base
  title={home.seoTitle || '臺灣慢活教育學會'}
  description={home.seoDescription}
>
  <div class="page" id="page-home">
    <!-- 1. 主視覺：輪播，一頁一句話 -->
    {slides.length > 0 && <HeroCarousel slides={slides} />}

    <!-- 2. 認識學會：一句主張＋說明 -->
    <section class="block statement" id="about" aria-labelledby="about-title">
      <div class="container statement-grid">
        <div>
          <h2 id="about-title" class="sr-only">認識學會</h2>
          {home.statement && <p class="statement-line" set:html={highlightHtml(home.statement, home.statementHighlight)} />}
        </div>
        <div class="statement-body">
          <PortableText value={aboutIntro} />
          <a class="text-link" href="/about">更多關於學會 →</a>
        </div>
      </div>
    </section>

    <!-- 3. 我們怎麼一起學：編號敘事 -->
    <section class="block block-alt" id="learning" aria-labelledby="learning-title">
      <div class="container">
        <h2 id="learning-title" class="block-title center">{learning.title || '我們怎麼一起學'}</h2>
        <ol class="story">
          {themes.map((t, i) => (
            <li class={`story-row ${i % 2 ? 'flip' : ''}`}>
              <div class="story-media">
                <span class="story-num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
                <Photo src={imageUrl(t.image, 1400)} alt={t.image?.alt || `${t.title}共學情境照片`} tone={themeTone(i)} icon={t.icon} class="story-photo" />
              </div>
              <div class="story-text">
                {t.en && <p class="story-en">{t.en}</p>}
                <h3 class="story-title">{t.title}</h3>
                {t.description && <p class="story-desc">{t.description}</p>}
                {t.category && <a class="text-link" href={`/column?cat=${t.category}`}>閱讀{t.title}相關文章 →</a>}
              </div>
            </li>
          ))}
        </ol>

        {activityTypes.length ? (
          <>
            <h3 class="formats-h" id="formats">{learning.formatsTitle || '學會活動'}</h3>
            <FormatList formats={activityTypes} />
            <p class="formats-more"><a class="text-link" href="/events">看所有活動與活動回顧 →</a></p>
          </>
        ) : null}
      </div>
    </section>

    <!-- 4. 近期活動 -->
    <section class="block" id="events" aria-labelledby="events-title">
      <div class="container">
        <div class="block-head">
          <div>
            <h2 id="events-title" class="block-title">{home.eventsTitle || '近期活動'}</h2>
            {home.eventsSub && <p class="block-sub">{home.eventsSub}</p>}
          </div>
          <a class="text-link" href="/events">查看所有活動 →</a>
        </div>
        <div class="grid-3">
          {events.map((e) => <EventCard event={e} />)}
        </div>
      </div>
    </section>

    <!-- 5. 大圖入口 -->
    <section class="block block-alt" aria-labelledby="tiles-title">
      <div class="container">
        <h2 id="tiles-title" class="block-title center">{home.tilesTitle || '探索更多'}</h2>
        <ul class="tiles">
          {(home.tiles ?? []).map((t) => (
            <li>
              <a class={`tile tone-${t.tone ?? 'forest'}`} href={t.href} {...ext(t.href)}>
                {t.image?.asset && <img src={imageUrl(t.image, 1000)} alt="" loading="lazy" decoding="async" />}
                <span class="tile-title">{t.title}</span>
                {t.text && <span class="tile-text">{t.text}</span>}
                <span class="tile-arrow" aria-hidden="true">→</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- 6. 滿版行動呼籲 -->
    <section class="cta-band" aria-labelledby="cta-title">
      <div class="container cta-inner">
        <div>
          <h2 id="cta-title" class="cta-title">{home.ctaTitle || '一起慢下來'}</h2>
          {home.ctaText && <p class="cta-sub">{home.ctaText}</p>}
        </div>
        <div class="cta-actions">
          {(home.ctaButtons ?? []).map((b, i) => (
            <a class={`btn ${i === 0 ? 'btn-solid' : 'btn-outline'}`} href={b.href} {...ext(b.href)}>{b.label} →</a>
          ))}
        </div>
      </div>
    </section>
  </div>
</Base>

<style>
  .center { text-align: center; }

  /* 2. 一句主張＋說明 */
  .statement-grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr); gap: clamp(2rem, 6vw, 6rem); align-items: center; }
  .statement-line { font-size: clamp(1.7rem, 3.4vw, 2.5rem); font-weight: 700; line-height: 1.6; letter-spacing: 0.06em; color: var(--ink); }
  /* 仿 TFT 的手繪圈選：用底部色塊強調關鍵字 */
  .statement-line :global(mark) {
    background: linear-gradient(transparent 58%, var(--clay) 58%, var(--clay) 92%, transparent 92%);
    color: inherit; padding: 0 0.1em;
  }
  .statement-body :global(.pt) { font-size: 1rem; line-height: 2.1; color: var(--ink-soft); margin-bottom: 1.4rem; }
  @media (max-width: 860px) { .statement-grid { grid-template-columns: minmax(0, 1fr); } }

  /* 3. 編號敘事 */
  .story { list-style: none; display: grid; gap: clamp(3rem, 6vw, 5rem); margin-top: clamp(2.5rem, 5vw, 4rem); }
  .story-row { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr); gap: clamp(2rem, 5vw, 5rem); align-items: center; }
  .story-row.flip .story-media { order: 2; }
  .story-media { position: relative; }
  .story-media :global(.story-photo) { aspect-ratio: 4 / 3; border-radius: var(--radius); box-shadow: var(--shadow); }
  .story-num {
    position: absolute; z-index: 1; top: -0.55em; left: 0.3em;
    font-size: clamp(3rem, 6vw, 4.5rem); font-weight: 700; line-height: 1; color: var(--forest);
    font-family: 'Cormorant Garamond', serif; font-style: italic;
  }
  .story-row.flip .story-num { left: auto; right: 0.3em; }
  .story-en { font-family: 'Cormorant Garamond', serif; font-style: italic; font-size: 1.1rem; color: var(--ink-soft); letter-spacing: 0.08em; }
  .story-title { font-size: clamp(1.4rem, 2.6vw, 1.8rem); font-weight: 700; color: var(--ink); letter-spacing: 0.1em; margin: 0.3rem 0 1rem; }
  .story-desc { font-size: 1.02rem; line-height: 2.1; color: var(--ink-soft); margin-bottom: 1.2rem; max-width: 30em; }
  .formats-h {
    margin: clamp(4rem, 7vw, 6rem) 0 2rem; text-align: center;
    font-size: clamp(1.3rem, 2.4vw, 1.6rem); font-weight: 700; color: var(--ink); letter-spacing: 0.12em;
  }
  @media (max-width: 760px) {
    .story-row { grid-template-columns: minmax(0, 1fr); gap: 1.6rem; }
    .story-row.flip .story-media { order: 0; }
    .story-row.flip .story-num { right: auto; left: 0.3em; }
  }

  .formats-more { margin-top: 2.4rem; text-align: center; }

  /* 5. 大圖入口 */
  .tiles { list-style: none; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: clamp(1rem, 2vw, 1.5rem); margin-top: 2.5rem; }
  .tile {
    position: relative; display: flex; flex-direction: column; justify-content: flex-start;
    min-height: clamp(180px, 22vw, 280px); padding: clamp(1.4rem, 3vw, 2.2rem);
    border-radius: var(--radius); overflow: hidden; color: #fff; text-decoration: none;
    box-shadow: var(--shadow); transition: box-shadow 0.25s, transform 0.25s;
  }
  .tile img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; z-index: 0; filter: brightness(0.7); }
  .tile > span { position: relative; z-index: 1; }
  .tile.tone-forest { background: linear-gradient(140deg, #4C7558, var(--forest)); }
  .tile.tone-slate { background: linear-gradient(140deg, #6A8794, var(--slate)); }
  .tile.tone-clay { background: linear-gradient(140deg, #A9774F, var(--clay-deep)); }
  .tile.tone-olive { background: linear-gradient(140deg, #7A8752, var(--olive)); }
  .tile:hover { box-shadow: var(--shadow-hover); transform: translateY(-3px); }
  .tile:focus-visible { outline: 3px solid var(--forest); outline-offset: 4px; }
  .tile-title { font-size: clamp(1.4rem, 2.6vw, 1.9rem); font-weight: 700; letter-spacing: 0.12em; }
  .tile-text { margin-top: 0.5rem; font-size: 1rem; letter-spacing: 0.06em; opacity: 0.92; }
  .tile-arrow {
    position: absolute !important; right: clamp(1.2rem, 2.5vw, 1.8rem); bottom: clamp(1.2rem, 2.5vw, 1.8rem);
    width: 52px; height: 52px; border-radius: 50%; background: #fff; color: var(--ink);
    display: flex; align-items: center; justify-content: center; font-size: 1.5rem; font-weight: 700;
    transition: transform 0.25s;
  }
  .tile:hover .tile-arrow { transform: translateX(4px); }
  @media (max-width: 640px) { .tiles { grid-template-columns: minmax(0, 1fr); } }

  /* 6. 滿版行動呼籲 */
  /* 用陶土暖色，和下方深綠頁尾分開 */
  .cta-band { background: linear-gradient(120deg, var(--clay), #F1E4D6); color: var(--ink); padding: clamp(3.5rem, 8vw, 6rem) 0; }
  .cta-inner { display: flex; justify-content: space-between; align-items: center; gap: 2rem; flex-wrap: wrap; }
  .cta-title { font-size: clamp(1.8rem, 4vw, 2.6rem); font-weight: 700; letter-spacing: 0.16em; }
  .cta-sub { margin-top: 0.9rem; font-size: 1.05rem; line-height: 1.9; color: var(--ink-soft); letter-spacing: 0.06em; }
  .cta-actions { display: flex; flex-direction: column; gap: 0.9rem; min-width: 12rem; }
  @media (max-width: 640px) { .cta-actions { flex-direction: row; flex-wrap: wrap; } }
</style>
