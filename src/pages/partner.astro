---
import Base from '../layouts/Base.astro'
import PortableText from '../components/PortableText.astro'
import { fetchOne, Q } from '../lib/sanity'
import { getSettings, cardHref } from '../lib/site'

// 全部內容在後台「頁面文案 → 與我們合作」。
// 卡片按鈕：有填「按鈕連結」（例如日後的線上表單）就用它，沒有就寄信給學會並帶入主旨。
type Card = {
  _key: string
  anchor?: string
  icon?: string
  title: string
  text?: string
  ctaLabel: string
  href?: string
  emailSubject?: string
  note?: string
}
type Page = { title: string; lead?: string; seoDescription?: string; cards?: Card[]; footnote?: any[] }
// 「個人捐款」區塊的內容在後台「頁面文案 → 與我們合作・捐款資訊」（原本的捐款支持頁，/donate 會轉到這裡）
type Donate = {
  title?: string
  intro?: string
  uses?: { _key: string; icon?: string; title: string; description?: string }[]
  accountName?: string
  bankName?: string
  accountNo?: string
  receiptNote?: string
  notes?: string[]
}
const [page, settings, donate] = await Promise.all([
  fetchOne<Page>(Q.partnerPage, {}, '與我們合作頁面'),
  getSettings(),
  fetchOne<Donate>(Q.donate, {}, '捐款資訊'),
])
// 個人捐款已經有完整區塊，卡片只列其他合作方式
const cards = (page.cards ?? []).filter((c) => c.anchor !== 'donate')
---
<Base
  title={page.title}
  description={page.seoDescription}
>
  <div class="page" id="page-partner">
    <header class="page-head">
      <div class="container">
        <p class="crumbs"><a href="/">首頁</a> / {page.title}</p>
        <h1>{page.title}</h1>
        {page.lead && <p class="lead">{page.lead}</p>}
      </div>
    </header>

    <section class="block" id="donate" aria-labelledby="donate-title">
      <div class="container">
        <h2 id="donate-title" class="block-title">{donate.title || '個人捐款'}</h2>
        {donate.intro && <p class="donate-intro">{donate.intro}</p>}
        <div class="donate-grid">
          {donate.uses?.length ? (
            <div>
              <h3 class="donate-h">您的捐款用於</h3>
              <ul class="donate-uses">
                {donate.uses.map((u) => (
                  <li>
                    {u.icon && <span class="donate-use-icon" aria-hidden="true">{u.icon}</span>}
                    <div>
                      <p class="donate-use-title">{u.title}</p>
                      {u.description && <p class="donate-use-text">{u.description}</p>}
                    </div>
                  </li>
                ))}
              </ul>
            </div>
          ) : null}
          <div class="card donate-box">
            <div class="card-body">
              <h3 class="donate-h">捐款方式・銀行匯款</h3>
              <dl class="donate-bank">
                {donate.accountName && <div><dt>戶名</dt><dd>{donate.accountName}</dd></div>}
                {donate.bankName && <div><dt>銀行</dt><dd>{donate.bankName}</dd></div>}
                {donate.accountNo && <div><dt>帳號</dt><dd>{donate.accountNo}</dd></div>}
              </dl>
              {donate.receiptNote && (
                <>
                  <h4 class="donate-sub">捐款收據</h4>
                  <p class="donate-note">{donate.receiptNote}</p>
                </>
              )}
              {donate.notes?.length ? (
                <ul class="donate-notes">{donate.notes.map((n) => <li>{n}</li>)}</ul>
              ) : null}
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="block block-alt" id="ways" aria-labelledby="ways-title">
      <div class="container">
        <h2 id="ways-title" class="block-title ways-title">企業、學校與團體合作</h2>
        <ul class="partner-list">
          {cards.map((c) => (
            <li class="card partner-card" id={c.anchor}>
              <div class="card-body">
                <span class="partner-icon" aria-hidden="true">{c.icon}</span>
                <h2 class="card-title">{c.title}</h2>
                {c.text && <p class="card-text">{c.text}</p>}
                <div class="card-foot">
                  <a class="btn btn-solid btn-sm" href={cardHref(c, settings.email)}>{c.ctaLabel}</a>
                </div>
              </div>
            </li>
          ))}
        </ul>
        {page.footnote && <div class="partner-more rich-links"><PortableText value={page.footnote} /></div>}
      </div>
    </section>
  </div>
</Base>

<style>
  .partner-list { list-style: none; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: clamp(1.25rem, 2vw, 2rem); }
  @media (max-width: 1000px) { .partner-list { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  /* 個人捐款 */
  #donate { scroll-margin-top: calc(var(--header-h) + 1rem); }
  .donate-intro { margin: 1rem 0 2.4rem; max-width: 42em; font-size: 1.05rem; line-height: 2; color: var(--ink-soft); }
  .donate-grid { display: grid; grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr); gap: clamp(2rem, 4vw, 4rem); align-items: start; }
  .donate-h { font-size: 1.15rem; font-weight: 700; color: var(--ink); letter-spacing: 0.08em; margin-bottom: 1.2rem; }
  .donate-uses { list-style: none; display: grid; gap: 1.3rem; }
  .donate-uses li { display: flex; gap: 1rem; align-items: flex-start; }
  .donate-use-icon { flex: none; width: 46px; height: 46px; border-radius: 50%; background: var(--forest-pale); display: inline-flex; align-items: center; justify-content: center; font-size: 1.3rem; }
  .donate-use-title { font-weight: 600; font-size: 1.05rem; color: var(--ink); }
  .donate-use-text { margin-top: 0.2rem; font-size: 0.98rem; line-height: 1.85; color: var(--ink-soft); }
  .donate-bank { display: grid; gap: 0.5rem; font-size: 1rem; }
  .donate-bank div { display: flex; gap: 1rem; }
  .donate-bank dt { flex: none; width: 3em; color: var(--ink-soft); }
  .donate-bank dd { margin: 0; font-weight: 600; color: var(--ink); }
  .donate-sub { margin-top: 1.6rem; font-size: 0.95rem; color: var(--ink-soft); font-weight: 600; letter-spacing: 0.08em; }
  .donate-note { margin-top: 0.3rem; font-size: 0.98rem; line-height: 1.9; color: var(--ink-soft); }
  .donate-notes { margin-top: 1.4rem; padding: 1rem 1.2rem 1rem 2.2rem; background: var(--forest-pale); border-radius: var(--radius-sm); font-size: 0.95rem; line-height: 1.95; color: var(--forest-deep); }
  @media (max-width: 860px) { .donate-grid { grid-template-columns: minmax(0, 1fr); } }
  .partner-card { scroll-margin-top: calc(var(--header-h) + 1.5rem); }
  .partner-card:target { outline: 3px solid var(--forest); outline-offset: 3px; }
  .partner-icon { font-size: 2rem; }
  .ways-title { margin-bottom: 2rem; }
  .partner-more { margin-top: 2.5rem; font-size: 1rem; color: var(--ink-soft); line-height: 2; }
  @media (max-width: 720px) { .partner-list { grid-template-columns: minmax(0, 1fr); } }
</style>
