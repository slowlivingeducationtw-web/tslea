---
import Base from '../layouts/Base.astro'
import { mailto } from '../data/site'

// 與我們合作：個人捐款連到既有的 /donate；其餘三項尚無線上表單，
// 先以「預先填好主旨的 Email」聯絡學會，表單完成後把 href 換掉即可。
// 說明文字只寫已發生或年度計畫已列的合作方式（校園放映座談、SEL 校園講座、企業贊助公益專案）。
const WAYS = [
  {
    id: 'donate',
    icon: '💚',
    title: '個人捐款',
    text: '您的支持將用於推動慢活共學活動、藝術陪伴與公益專案，讓更多人有機會放慢腳步、一起學習。',
    cta: '前往捐款支持',
    href: '/donate',
  },
  {
    id: 'business',
    icon: '🤝',
    title: '企業合作',
    text: '歡迎理念相近的企業贊助學會的公益專案活動，或與我們共同規劃合作方案，一起推廣慢活教育。',
    cta: '來信洽談企業合作',
    href: mailto('企業合作洽詢'),
  },
  {
    id: 'school',
    icon: '🏫',
    title: '合作學校',
    text: '歡迎學校與我們聯繫，共同規劃校園講座、紀錄片放映與映後座談等活動，把社會情緒學習與慢活實踐帶進校園。',
    cta: '來信洽談學校合作',
    href: mailto('學校合作洽詢'),
  },
  {
    id: 'talk',
    icon: '🎙️',
    title: '課程演講邀約',
    text: '學會夥伴來自身心健康、藝術陪伴、生態永續等不同領域。歡迎機關、社區與團體邀請講座或課程，來信請告訴我們時間、對象、人數與希望的主題。',
    cta: '來信邀約課程演講',
    href: mailto('課程演講邀約'),
  },
]
---
<Base
  title="與我們合作"
  description="與臺灣慢活教育學會合作：個人捐款、企業合作、合作學校、課程演講邀約。"
>
  <div class="page" id="page-partner">
    <header class="page-head">
      <div class="container">
        <p class="crumbs"><a href="/">首頁</a> / 與我們合作</p>
        <h1>與我們合作</h1>
        <p class="lead">慢活教育需要更多夥伴一起推動。無論是個人、企業、學校或團體，都歡迎用適合的方式與我們同行。</p>
      </div>
    </header>

    <section class="block">
      <div class="container">
        <ul class="partner-list">
          {WAYS.map((w) => (
            <li class="card partner-card" id={w.id}>
              <div class="card-body">
                <span class="partner-icon" aria-hidden="true">{w.icon}</span>
                <h2 class="card-title">{w.title}</h2>
                <p class="card-text">{w.text}</p>
                <div class="card-foot">
                  <a class="btn btn-solid btn-sm" href={w.href}>{w.cta}</a>
                </div>
              </div>
            </li>
          ))}
        </ul>
        <p class="partner-more">其他合作想法，也歡迎前往<a class="text-link" href="/contact">聯絡我們</a>。</p>
      </div>
    </section>
  </div>
</Base>

<style>
  .partner-list { list-style: none; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: clamp(1.25rem, 2vw, 2rem); }
  .partner-card { scroll-margin-top: calc(var(--header-h) + 1.5rem); }
  .partner-card:target { outline: 3px solid var(--forest); outline-offset: 3px; }
  .partner-icon { font-size: 2rem; }
  .partner-more { margin-top: 2.5rem; font-size: 1rem; color: var(--ink-soft); line-height: 2; }
  @media (max-width: 720px) { .partner-list { grid-template-columns: minmax(0, 1fr); } }
</style>
