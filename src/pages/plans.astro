---
import Base from '../layouts/Base.astro'
import PortableText from '../components/PortableText.astro'
import { sanity, fetchOne, Q } from '../lib/sanity'

const TRACKS = [
  { key: 'org', label: '會務運作' },
  { key: 'learn', label: '業務發展' },
  { key: 'project', label: '專案計畫' },
  { key: 'finance', label: '財務規劃' },
] as const

type Page = {
  label?: string
  title: string
  intro?: string
  tracks?: { track: string; body?: any }[]
}
type Item = { track: string; icon?: string; title: string; description?: string }

const page = await fetchOne<Page>(Q.plansPage, {}, '年度計畫頁面')
const items = await sanity.fetch<Item[]>(Q.planItems)

const introOf = (k: string) => page.tracks?.find((t) => t.track === k)?.body
const itemsOf = (k: string) => items.filter((i) => i.track === k)
---
<Base
  title={page.title}
  description="臺灣慢活教育學會115至116年度工作計畫：會務運作、業務發展、專案計畫與財務規劃四大面向。"
>
  <div class="page" id="page-plans">
    <div class="page-banner" style="background:var(--cream);padding:5rem 5rem 3rem">
      {page.label && <p class="sec-label">{page.label}</p>}
      <h2 class="sec-title">{page.title}</h2>
      {page.intro && (
        <p style="font-size:0.88rem;line-height:2;color:var(--muted);max-width:650px">{page.intro}</p>
      )}
    </div>

    <section class="sec" style="background:var(--warm-white);padding-top:3rem">
      <div class="plans-tabs">
        {TRACKS.map((t, i) => (
          <button
            class={`plan-tab${i === 0 ? ' active' : ''}`}
            data-plan={t.key}
            type="button"
            role="tab"
            aria-selected={i === 0 ? 'true' : 'false'}
            aria-controls={`plan-${t.key}`}
          >{t.label}</button>
        ))}
      </div>

      {TRACKS.map((t, i) => (
        <div class={`plan-content${i === 0 ? ' active' : ''}`} id={`plan-${t.key}`}>
          <div class="plan-intro">
            <PortableText value={introOf(t.key)} />
          </div>
          <div class="plan-items">
            {itemsOf(t.key).map((it) => (
              <div class="plan-item">
                <div class="plan-item-title">{it.icon ? `${it.icon} ` : ''}{it.title}</div>
                {it.description && <div class="plan-item-desc">{it.description}</div>}
              </div>
            ))}
          </div>
        </div>
      ))}
    </section>
  </div>

  <script is:inline>
    (function () {
      const tabs = document.querySelectorAll('.plan-tab');
      const panels = document.querySelectorAll('.plan-content');
      tabs.forEach(function (t) {
        t.addEventListener('click', function () {
          tabs.forEach(function (x) { x.classList.remove('active'); x.setAttribute('aria-selected', 'false'); });
          panels.forEach(function (p) { p.classList.remove('active'); });
          t.classList.add('active');
          t.setAttribute('aria-selected', 'true');
          const panel = document.getElementById('plan-' + t.dataset.plan);
          if (panel) panel.classList.add('active');
        });
      });
    })();
  </script>
</Base>
