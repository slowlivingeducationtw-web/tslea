---
import Base from '../layouts/Base.astro';
---
<Base title="理監事名單"
      description="臺灣慢活教育學會第一屆理事長、常務理事、理事與監事名單，以及各自的專業領域介紹。">
  <div class="page" id="page-board">
      <div class="board-page-header">
        <p class="sec-label">Our Team</p>
        <h2 class="sec-title">第一屆理監事名單</h2>
      </div>
      <section class="sec" style="background:var(--warm-white);padding-top:3rem">

        <!-- 理事 -->
        <div style="margin-bottom:2.5rem">
          <div style="font-size:0.72rem;letter-spacing:0.25em;color:var(--earth);margin-bottom:1.5rem;padding-bottom:0.6rem;border-bottom:1px solid var(--border)">理　事</div>
          <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(160px,1fr));gap:1px;margin-bottom:1px">
            <div style="background:var(--earth-pale);padding:1.4rem 1.5rem;border-top:2px solid var(--earth)">
              <div style="font-size:0.65rem;letter-spacing:0.2em;color:var(--earth);margin-bottom:0.4rem">理事長</div>
              <div style="font-size:1rem;font-weight:600;letter-spacing:0.12em;color:var(--charcoal)">陳鵬文</div>
            </div>
            <div style="background:var(--earth-pale);padding:1.4rem 1.5rem;border-top:2px solid var(--earth-light)">
              <div style="font-size:0.65rem;letter-spacing:0.2em;color:var(--earth);margin-bottom:0.4rem">副理事長</div>
              <div style="font-size:1rem;font-weight:600;letter-spacing:0.12em;color:var(--charcoal)">邱曉琳</div>
            </div>
          </div>
          <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(130px,1fr));gap:1px">
            <div style="background:var(--cream);padding:1.2rem 1.5rem"><div style="font-size:0.63rem;letter-spacing:0.2em;color:var(--muted);margin-bottom:0.35rem">理事</div><div style="font-size:0.95rem;font-weight:600;letter-spacing:0.12em;color:var(--charcoal)">張世宗</div></div>
            <div style="background:var(--cream);padding:1.2rem 1.5rem"><div style="font-size:0.63rem;letter-spacing:0.2em;color:var(--muted);margin-bottom:0.35rem">理事</div><div style="font-size:0.95rem;font-weight:600;letter-spacing:0.12em;color:var(--charcoal)">陳君山</div></div>
            <div style="background:var(--cream);padding:1.2rem 1.5rem"><div style="font-size:0.63rem;letter-spacing:0.2em;color:var(--muted);margin-bottom:0.35rem">理事</div><div style="font-size:0.95rem;font-weight:600;letter-spacing:0.12em;color:var(--charcoal)">張蕊仙</div></div>
            <div style="background:var(--cream);padding:1.2rem 1.5rem"><div style="font-size:0.63rem;letter-spacing:0.2em;color:var(--muted);margin-bottom:0.35rem">理事</div><div style="font-size:0.95rem;font-weight:600;letter-spacing:0.12em;color:var(--charcoal)">謝啟彬</div></div>
            <div style="background:var(--cream);padding:1.2rem 1.5rem"><div style="font-size:0.63rem;letter-spacing:0.2em;color:var(--muted);margin-bottom:0.35rem">理事</div><div style="font-size:0.95rem;font-weight:600;letter-spacing:0.12em;color:var(--charcoal)">鄭麗寶</div></div>
            <div style="background:var(--cream);padding:1.2rem 1.5rem"><div style="font-size:0.63rem;letter-spacing:0.2em;color:var(--muted);margin-bottom:0.35rem">理事</div><div style="font-size:0.95rem;font-weight:600;letter-spacing:0.12em;color:var(--charcoal)">郭純嵐</div></div>
            <div style="background:var(--cream);padding:1.2rem 1.5rem"><div style="font-size:0.63rem;letter-spacing:0.2em;color:var(--muted);margin-bottom:0.35rem">理事</div><div style="font-size:0.95rem;font-weight:600;letter-spacing:0.12em;color:var(--charcoal)">吳順卿</div></div>
          </div>
        </div>

        <!-- 監事 -->
        <div style="margin-bottom:2.5rem">
          <div style="font-size:0.72rem;letter-spacing:0.25em;color:var(--sky);margin-bottom:1.5rem;padding-bottom:0.6rem;border-bottom:1px solid var(--border)">監　事</div>
          <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(130px,1fr));gap:1px">
            <div style="background:var(--sky-pale);padding:1.2rem 1.5rem"><div style="font-size:0.63rem;letter-spacing:0.2em;color:var(--sky);margin-bottom:0.35rem">監事</div><div style="font-size:0.95rem;font-weight:600;letter-spacing:0.12em;color:var(--charcoal)">楊秋玉</div></div>
            <div style="background:var(--sky-pale);padding:1.2rem 1.5rem"><div style="font-size:0.63rem;letter-spacing:0.2em;color:var(--sky);margin-bottom:0.35rem">監事</div><div style="font-size:0.95rem;font-weight:600;letter-spacing:0.12em;color:var(--charcoal)">陳建城</div></div>
            <div style="background:var(--sky-pale);padding:1.2rem 1.5rem"><div style="font-size:0.63rem;letter-spacing:0.2em;color:var(--sky);margin-bottom:0.35rem">監事</div><div style="font-size:0.95rem;font-weight:600;letter-spacing:0.12em;color:var(--charcoal)">李佳穗</div></div>
          </div>
        </div>

        <!-- 行政秘書處 -->
        <div style="margin-bottom:2.5rem">
          <div style="font-size:0.72rem;letter-spacing:0.25em;color:var(--sage);margin-bottom:1.5rem;padding-bottom:0.6rem;border-bottom:1px solid var(--border)">行政秘書處</div>
          <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(130px,1fr));gap:1px">
            <div style="background:var(--sage-pale);padding:1.2rem 1.5rem"><div style="font-size:0.63rem;letter-spacing:0.2em;color:var(--sage);margin-bottom:0.35rem">秘書長</div><div style="font-size:0.95rem;font-weight:600;letter-spacing:0.12em;color:var(--charcoal)">許宸豪</div></div>
            <div style="background:var(--sage-pale);padding:1.2rem 1.5rem"><div style="font-size:0.63rem;letter-spacing:0.2em;color:var(--sage);margin-bottom:0.35rem">總幹事</div><div style="font-size:0.95rem;font-weight:600;letter-spacing:0.12em;color:var(--charcoal)">李亮誼</div></div>
          </div>
        </div>

        <!-- 顧問 -->
        <div>
          <div style="font-size:0.72rem;letter-spacing:0.25em;color:var(--earth);margin-bottom:1.5rem;padding-bottom:0.6rem;border-bottom:1px solid var(--border)">顧　問</div>
          <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(200px,1fr));gap:1px">
            <div style="background:var(--earth-pale);padding:1.2rem 1.5rem"><div style="font-size:0.63rem;letter-spacing:0.2em;color:var(--earth);margin-bottom:0.35rem">財務顧問</div><div style="font-size:0.88rem;font-weight:600;letter-spacing:0.06em;color:var(--charcoal);line-height:1.6">李臺鴒會計稅務<br>記帳士事務所</div></div>
            <div style="background:var(--earth-pale);padding:1.2rem 1.5rem"><div style="font-size:0.63rem;letter-spacing:0.2em;color:var(--earth);margin-bottom:0.35rem">旅遊顧問</div><div style="font-size:0.88rem;font-weight:600;letter-spacing:0.08em;color:var(--charcoal)">仁愛旅行社</div></div>
            <div style="background:var(--earth-pale);padding:1.2rem 1.5rem"><div style="font-size:0.63rem;letter-spacing:0.2em;color:var(--earth);margin-bottom:0.35rem">資訊顧問</div><div style="font-size:0.88rem;font-weight:600;letter-spacing:0.08em;color:var(--charcoal)">蔡尚諭</div></div>
          </div>
        </div>
      </section>
  </div>
</Base>
