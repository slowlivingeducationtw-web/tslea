---
// 主題頁：/themes/{slug}，首頁「我們怎麼一起學」的 01–03 點進來先到這裡，
// 多介紹一點這個主題，再列出相關活動與專欄文章。內容在後台「頁面文案 → 慢活共學主題＋學會活動類別」。
// 版面與活動頁、文章頁一致：電腦版左側列出三大主題。
import Base from '../../layouts/Base.astro'
import PortableText from '../../components/PortableText.astro'
import Photo from '../../components/Photo.astro'
import EventCard from '../../components/EventCard.astro'
import ArticleCard from '../../components/ArticleCard.astro'
import SideList from '../../components/SideList.astro'
import { sanity, Q, imageUrl } from '../../lib/sanity'
import { themeTone } from '../../lib/site'
import { categoryOf, getArticles } from '../../lib/column'
import type { CmsEvent } from '../../lib/events'

type ThemePage = {
  _key: string
  icon?: string
  title: string
  en?: string
  description?: string
  image?: { asset?: any; alt?: string }
  category?: string
  slug: string
  body?: any[]
  events?: (CmsEvent | null)[]
}

export async function getStaticPaths() {
  const themes = (await sanity.fetch<ThemePage[]>(Q.themePages)) ?? []
  return themes.map((t, i) => ({ params: { slug: t.slug }, props: { theme: t, index: i, all: themes } }))
}

const { theme: t, index, all } = Astro.props as { theme: ThemePage; index: number; all: ThemePage[] }
const tone = themeTone(index)
const cover = imageUrl(t.image, 1600)
const events = (t.events ?? []).filter((e): e is CmsEvent => !!e?.slug)
const articles = t.category ? (await getArticles()).filter((a) => a.category === t.category) : []
const shownArticles = articles.slice(0, 6)
const cat = t.category ? categoryOf(t.category) : undefined

const side = [{
  title: '三大共學主題',
  items: all.map((x, i) => ({
    href: `/themes/${x.slug}`,
    title: `${String(i + 1).padStart(2, '0')}　${x.title}`,
    meta: x.en,
    current: x.slug === t.slug,
  })),
}]
---
<Base title={t.title} description={t.description} ogImage={cover}>
  <div class="page" id="page-theme">
    <div class="container detail-layout">
      <SideList heading="慢活共學" headingHref="/#learning" label="三大共學主題" groups={side} />

      <div>
        <header class="detail-head">
          <div class="detail-narrow">
            <p class="crumbs"><a href="/">首頁</a> / <a href="/#learning">三大共學主題</a> / {t.title}</p>
            <p class="tp-num" aria-hidden="true">{String(index + 1).padStart(2, '0')}</p>
            {t.en && <p class="tp-en">{t.en}</p>}
            <h1>{t.title}</h1>
            {t.description && <p class="tp-lead">{t.description}</p>}
          </div>
        </header>

        <article class="detail-narrow">
          <Photo src={cover} alt={t.image?.alt || `${t.title}共學情境照片`} tone={tone} icon={t.icon}
                 placeholder="照片待補" class="tp-photo" eager />
          {t.body?.length ? <div class="detail-text rich-links"><PortableText value={t.body} /></div> : null}
        </article>

        {events.length > 0 && (
          <section class="tp-more" aria-labelledby="t-events">
            <div class="block-head">
              <h2 id="t-events" class="tp-h">相關活動</h2>
              <a class="text-link" href="/events#list">看所有活動 →</a>
            </div>
            <div class="grid-2">{events.map((e) => <EventCard event={e} />)}</div>
          </section>
        )}

        {cat && (
          <section class="tp-more" aria-labelledby="t-articles">
            <div class="block-head">
              <h2 id="t-articles" class="tp-h">相關文章</h2>
              {articles.length > 0 && <a class="text-link" href={`/column?cat=${cat.value}`}>看全部{cat.label}文章 →</a>}
            </div>
            {shownArticles.length > 0 ? (
              <div class="grid-2">{shownArticles.map((a) => <ArticleCard article={a} />)}</div>
            ) : (
              <p class="tp-empty rich-links">這個主題的專欄文章正在準備中，歡迎<a href="/contact">投稿分享</a>你的慢活實踐。</p>
            )}
          </section>
        )}
      </div>
    </div>
  </div>
</Base>

<style>
  .tp-num { font-family: 'Cormorant Garamond', serif; font-style: italic; font-weight: 700; font-size: clamp(2.6rem, 5vw, 3.6rem); line-height: 1; color: var(--forest); }
  .tp-en { margin-top: 0.4rem; font-family: 'Cormorant Garamond', serif; font-style: italic; font-size: 1.15rem; color: var(--ink-soft); letter-spacing: 0.04em; }
  .tp-lead { margin-top: 1rem; font-size: 1.1rem; line-height: 2; color: var(--ink-soft); }
  .detail-narrow :global(.tp-photo) { aspect-ratio: 16 / 9; border-radius: var(--radius); overflow: hidden; margin-bottom: 2.4rem; }
  .detail-narrow :global(.tp-photo img) { width: 100%; height: 100%; object-fit: cover; }
  .tp-more { margin-top: clamp(3rem, 6vw, 4.5rem); padding-top: 2.4rem; border-top: 1px solid var(--line); }
  .tp-h { font-size: clamp(1.3rem, 2.4vw, 1.6rem); font-weight: 700; color: var(--ink); letter-spacing: 0.1em; }
  .grid-2 { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: clamp(1.25rem, 2vw, 1.75rem); }
  .tp-empty { font-size: 1rem; line-height: 2; color: var(--ink-soft); }
  @media (max-width: 640px) { .grid-2 { grid-template-columns: minmax(0, 1fr); } }
</style>
