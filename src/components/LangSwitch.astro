---
// 右上角的語言切換：地球圖示＋下拉清單，切過去停在同一頁（查詢字串與錨點在點擊時接上）。
// 語言清單在 src/lib/i18n.ts 的 LANGS；之後加語言，這裡不用改。
import { LANGS, langOf, langInfo, localizePath } from '../lib/i18n'
import { t } from '../lib/ui'

const { path } = Astro.props
const lang = langOf(path)
---
<div class="lang-switch">
  <button type="button" class="lang-btn" id="langBtn" aria-haspopup="true" aria-expanded="false"
          aria-controls="langMenu" aria-label={t(lang, 'lang.label')}>
    <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
      <circle cx="12" cy="12" r="9" /><path d="M3 12h18M12 3c2.5 2.6 3.8 5.6 3.8 9s-1.3 6.4-3.8 9c-2.5-2.6-3.8-5.6-3.8-9S9.5 5.6 12 3z" />
    </svg>
    <span class="lang-short" aria-hidden="true">{langInfo(lang).short}</span>
    <span class="lang-caret" aria-hidden="true">▾</span>
  </button>
  <ul class="lang-menu" id="langMenu" hidden>
    {LANGS.map((l) => (
      <li>
        <a href={localizePath(l.code, path)} hreflang={l.hreflang} lang={l.htmlLang}
           aria-current={l.code === lang ? 'true' : undefined} data-lang-link>
          <span class="lang-check" aria-hidden="true">{l.code === lang ? '✓' : ''}</span>{l.label}
        </a>
      </li>
    ))}
  </ul>
</div>

<script is:inline>
// 語言下拉：點按鈕開關、Esc 或點外面關閉；切換時帶上目前的 ?查詢 與 #錨點
(function () {
  var btn = document.getElementById('langBtn');
  var menu = document.getElementById('langMenu');
  if (!btn || !menu) return;
  function setOpen(open) {
    menu.hidden = !open;
    btn.setAttribute('aria-expanded', String(open));
  }
  btn.addEventListener('click', function () {
    setOpen(menu.hidden);
    if (!menu.hidden) { var a = menu.querySelector('a'); if (a) a.focus(); }
  });
  document.addEventListener('click', function (e) {
    if (!menu.hidden && !e.target.closest('.lang-switch')) setOpen(false);
  });
  document.addEventListener('keydown', function (e) {
    if (e.key === 'Escape' && !menu.hidden) { setOpen(false); btn.focus(); }
  });
  menu.querySelectorAll('[data-lang-link]').forEach(function (a) {
    a.addEventListener('click', function () {
      a.href = a.getAttribute('href').split(/[?#]/)[0] + location.search + location.hash;
    });
  });
})();
</script>
