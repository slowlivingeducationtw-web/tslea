---
import { getNavigation, isExternal, type NavItem } from '../lib/site'

// 選單內容在後台「選單與頁尾」編輯
const { path } = Astro.props
const nav = await getNavigation()
const items = nav.mainNav ?? []
const cta = nav.headerCta
const current = (href: string) => (href === path ? 'page' : undefined)
// 子選單裡有目前頁面時，主項目也標示為所在區塊
const inSection = (item: NavItem) =>
  item.href === path || item.children?.some((c) => c.href === path)
const ext = (href: string) => (isExternal(href) ? { target: '_blank', rel: 'noopener' } : {})
// 子選單：後台勾「縮排一層」的項目收到上一個沒縮排的項目底下（例：全部文章 → 各分類）
type Sub = NonNullable<NavItem['children']>[number]
const nest = (children: Sub[] = []) =>
  children.reduce<{ link: Sub; subs: Sub[] }[]>((out, c) => {
    if (c.indent && out.length) out[out.length - 1].subs.push(c)
    else out.push({ link: c, subs: [] })
    return out
  }, [])
---
<header class="site-header" id="mainNav">
  <div class="site-header-inner">
    <a href="/" class="site-logo" aria-label="臺灣慢活教育學會 首頁">
      <img src="/images/logo-dark.png" alt="臺灣慢活教育學會 Slow Living Education Society of Taiwan"
           width="720" height="160">
    </a>

    <nav class="site-nav" id="navLinks" aria-label="主要導覽">
      <ul class="nav-top">
        {items.map((item) => (
          <li class={item.children?.length ? 'has-sub' : undefined}>
            <a href={item.href} class={inSection(item) ? 'in-section' : undefined}
               aria-current={current(item.href)} {...ext(item.href)}>
              {item.label}
              {item.children?.length ? <span class="sub-caret" aria-hidden="true"></span> : null}
            </a>
            {item.children?.length ? (
              <ul class="nav-sub" aria-label={`${item.label} 子選單`}>
                {nest(item.children).map(({ link: c, subs }) => (
                  <li class={subs.length ? 'has-nest' : undefined}>
                    <a href={c.href} {...ext(c.href)}>{c.label}</a>
                    {subs.length > 0 && (
                      <ul class="nav-nest">
                        {subs.map((x) => <li><a href={x.href} {...ext(x.href)}>{x.label}</a></li>)}
                      </ul>
                    )}
                  </li>
                ))}
              </ul>
            ) : null}
          </li>
        ))}
      </ul>
      {cta && <a href={cta.href} class="btn btn-solid nav-cta-menu">{cta.label}</a>}
    </nav>

    <div class="header-actions">
      {cta && <a href={cta.href} class="btn btn-solid btn-sm nav-cta">{cta.label}</a>}
      <button class="menu-btn" id="navToggle" type="button"
              aria-label="開啟選單" aria-expanded="false" aria-controls="navLinks">
        <span class="bars" aria-hidden="true"></span>
      </button>
    </div>
  </div>
</header>
