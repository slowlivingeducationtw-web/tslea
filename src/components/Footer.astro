---
import { CONTACT, FOOTER_GROUPS } from '../data/site'
---
<footer class="site-footer">
  <div class="container">
    <div class="footer-grid">
      <div class="footer-brand">
        <img class="footer-logo" src="/images/logo-light.png" width="880" height="197"
             alt="臺灣慢活教育學會 Slow Living Education Society of Taiwan">
        <a class="btn btn-outline on-dark btn-sm" href={CONTACT.facebook} target="_blank" rel="noopener">
          在 Facebook 保持關注<span class="sr-only">（另開新視窗）</span>
        </a>
        <p class="footer-addr">{CONTACT.address}</p>
      </div>

      {FOOTER_GROUPS.map((g) => (
        <nav aria-label={g.title}>
          <h2 class="footer-h">{g.title}</h2>
          <ul class="footer-links">
            {g.links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
          </ul>
        </nav>
      ))}

      <div>
        <h2 class="footer-h">聯絡我們</h2>
        <ul class="footer-links">
          <li><a href="/contact">聯絡方式</a></li>
          <li><a href={`mailto:${CONTACT.email}`}>來信給我們</a></li>
          <li><a href="/board-area">理監事專區</a></li>
        </ul>
      </div>
    </div>

    <p class="footer-bottom">
      © 2026 臺灣慢活教育學會 Slow Living Education Society of Taiwan · 非營利公益社會團體
    </p>
  </div>
</footer>
