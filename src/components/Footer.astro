---
import { getNavigation, getSettings, isExternal } from '../lib/site'

// 連結分組在後台「選單與頁尾」，地址、粉專、立案字號在「網站設定」
const [nav, s] = await Promise.all([getNavigation(), getSettings()])
const ext = (href: string) => (isExternal(href) ? { target: '_blank', rel: 'noopener' } : {})
const legal = [s.registrationNo && `立案字號：${s.registrationNo}`, s.taxId && `統一編號：${s.taxId}`].filter(Boolean)
---
<footer class="site-footer">
  <div class="container">
    <div class="footer-grid">
      <div class="footer-brand">
        <img class="footer-logo" src="/images/logo-light.png" width="880" height="197"
             alt="臺灣慢活教育學會 Slow Living Education Society of Taiwan">
        {s.facebook && (
          <a class="btn btn-outline on-dark btn-sm" href={s.facebook} target="_blank" rel="noopener">
            {nav.facebookLabel || 'Facebook 粉絲專頁'}<span class="sr-only">（另開新視窗）</span>
          </a>
        )}
        {s.address && <p class="footer-addr">{s.address}</p>}
      </div>

      {(nav.footerGroups ?? []).map((g) => (
        <nav aria-label={g.title}>
          <h2 class="footer-h">{g.title}</h2>
          <ul class="footer-links">
            {(g.links ?? []).map((l) => <li><a href={l.href} {...ext(l.href)}>{l.label}</a></li>)}
          </ul>
        </nav>
      ))}
    </div>

    <p class="footer-bottom">
      © {new Date().getFullYear()} {s.orgName || '臺灣慢活教育學會'} Slow Living Education Society of Taiwan
      {s.footerNote && <> · {s.footerNote}</>}
      {legal.length > 0 && <><br>{legal.join('　')}</>}
    </p>
  </div>
</footer>
