---
// 首頁主視覺輪播：每頁一句話＋一張照片（照片到位前用色塊）。
// 柔和淡入淡出、每 6 秒換頁；滑鼠移入或鍵盤聚焦時停止（2026-10 依學會要求拿掉暫停鈕）；
// 換頁：圓點、左右箭頭（電腦版）、手指左右滑（手機）、鍵盤左右方向鍵；
// 使用者系統設定「減少動態」時不自動播放。
import Photo from './Photo.astro'
import { langOf } from '../lib/i18n'
import { t } from '../lib/ui'

export type HeroSlide = {
  pre?: string
  /** 可用 <span class="nw">…</span> 包住不該拆開的詞組，換行只會發生在詞組之間 */
  title: string
  /** 長句用 'md' 較小字級 */
  size?: 'lg' | 'md'
  sub?: string
  tone: 'forest' | 'mist' | 'clay' | 'leaf'
  image: string | null
  imageAlt: string
  /** 背景影片（YouTube 片段，靜音循環）；載入前與「減少動態」時顯示 image 或影片縮圖 */
  video?: { id: string; start: number; end?: number }
}

type Props = { slides: HeroSlide[]; interval?: number }
const { slides, interval = 6000 } = Astro.props
const lang = langOf(Astro.url.pathname)
---
<section class="hero-c" aria-roledescription="carousel" aria-label={t(lang, 'hero.label')} data-interval={interval}
         data-video-title={t(lang, 'hero.videoTitle')}>
  {slides.map((s, i) => (
    <div class={`hero-slide tone-${s.tone}${i === 0 ? ' is-active' : ''}`}
         role="group" aria-roledescription="slide" aria-label={t(lang, 'hero.slide', { n: i + 1, total: slides.length })}
         aria-hidden={i === 0 ? undefined : 'true'}>
      <Photo src={s.image ?? (s.video ? `https://i.ytimg.com/vi/${s.video.id}/maxresdefault.jpg` : null)}
             alt={s.imageAlt} tone={s.tone === 'forest' ? 'forest' : s.tone}
             icon="🌳" placeholder={t(lang, 'photo.placeholder')} class="hero-c-media" eager={i === 0} />
      {s.video && (
        <div class="hero-video" aria-hidden="true"
             data-yt={s.video.id} data-start={s.video.start} data-end={s.video.end ?? ''}></div>
      )}
      <div class="hero-c-shade" aria-hidden="true"></div>
      <div class="container hero-c-inner">
        {s.pre && <p class="hero-c-pre">{s.pre}</p>}
        {i === 0
          ? <h1 class={`hero-c-title size-${s.size ?? 'lg'}`} set:html={s.title} />
          : <p class={`hero-c-title size-${s.size ?? 'lg'}`} set:html={s.title} />}
        {s.sub && <p class="hero-c-sub">{s.sub}</p>}
      </div>
    </div>
  ))}

  {slides.length > 1 && (
    <>
      <button type="button" class="hero-arrow is-prev" data-step="-1" aria-label={t(lang, 'hero.prev')}>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 5l-7 7 7 7" /></svg>
      </button>
      <button type="button" class="hero-arrow is-next" data-step="1" aria-label={t(lang, 'hero.next')}>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 5l7 7-7 7" /></svg>
      </button>
    </>
  )}

  {slides.length > 1 && (
    <div class="hero-ctrl">
      <div class="hero-dots" role="group" aria-label={t(lang, 'hero.dots')}>
        {slides.map((_, i) => (
          <button type="button" class="hero-dot" data-go={i}
                  aria-label={t(lang, 'hero.show', { n: i + 1 })} aria-current={i === 0 ? 'true' : undefined}></button>
        ))}
      </div>
    </div>
  )}
</section>

<script>
  document.querySelectorAll<HTMLElement>('.hero-c[aria-roledescription="carousel"]').forEach((root) => {
    const slides = [...root.querySelectorAll<HTMLElement>('.hero-slide')]
    const dots = [...root.querySelectorAll<HTMLButtonElement>('.hero-dot')]
    if (slides.length < 2) return

    const interval = Number(root.dataset.interval) || 6000
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches
    let current = 0
    let userPaused = reduce // 減少動態：預設不自動播放
    let hover = false
    let timer: number | undefined

    // ── 背景影片：輪到那一頁才載入 YouTube（靜音、循環指定片段）；減少動態或省流量模式不載入 ──
    const saveData = (navigator as any).connection?.saveData === true
    const canVideo = !reduce && !saveData
    type Vid = { box: HTMLElement; frame?: HTMLIFrameElement; start: number; end: number; state?: number; seeking?: boolean; showTimer?: number; played?: boolean }
    const vids = new Map<HTMLElement, Vid>()
    slides.forEach((s) => {
      const box = s.querySelector<HTMLElement>('.hero-video')
      if (box) vids.set(s, { box, start: Number(box.dataset.start) || 0, end: Number(box.dataset.end) || 0 })
    })
    // YouTube 在暫停、跳轉、緩衝時會在畫面正中間閃出暫停／播放圖示或轉圈圈（controls=0 也關不掉）。
    // 所以影片只在「確定正在播放」一小段時間後才淡入，其他狀態立刻退回照片，訪客就不會看到那些圖示。
    const reveal = (v: Vid) => {
      if (v.showTimer || v.box.classList.contains('is-playing')) return
      v.showTimer = window.setTimeout(() => {
        v.showTimer = undefined
        v.box.classList.add('is-playing')
        // 這次輪到它時第一次播起來：改成停留到片段播完
        if (!v.played && vids.get(slides[current]) === v) { v.played = true; schedule() }
      }, 900)
    }
    const conceal = (v: Vid) => {
      window.clearTimeout(v.showTimer)
      v.showTimer = undefined
      v.box.classList.remove('is-playing')
    }
    // 播放器會回報播放狀態與目前秒數；快到片段結尾先退回照片、再跳回開頭
    // （YouTube 的 loop 不支援指定片段，end 參數又會停在結束畫面）
    window.addEventListener('message', (ev) => {
      if (!/youtube(-nocookie)?\.com$/.test(new URL(ev.origin).hostname)) return
      let data: any
      try { data = typeof ev.data === 'string' ? JSON.parse(ev.data) : ev.data } catch { return }
      const info = data?.info
      if (!info) return
      vids.forEach((v) => {
        if (v.frame?.contentWindow !== ev.source) return
        if (typeof info.playerState === 'number') v.state = info.playerState
        const t = info.currentTime
        if (typeof t === 'number' && v.end > v.start) {
          if (t >= v.end - 1.2 && !v.seeking) {
            v.seeking = true
            conceal(v)
            window.setTimeout(() => { cmd(v, 'seekTo', [v.start, true]); cmd(v, 'playVideo') }, 500)
          } else if (v.seeking && t >= v.start && t < v.end - 2) {
            v.seeking = false
          }
        }
        const inRange = typeof t !== 'number' || v.end <= v.start || (t >= v.start && t < v.end - 1.2)
        if ((v.state === 1 || (v.state === undefined && typeof info.currentTime === 'number')) && !v.seeking && inRange) reveal(v)
        else if (v.state !== undefined && v.state !== 1) conceal(v)
      })
    })
    const cmd = (v: Vid, func: string, args: unknown[] = []) =>
      v.frame?.contentWindow?.postMessage(JSON.stringify({ event: 'command', func, args }), '*')
    let playVideo = function (s: HTMLElement) {
      const v = vids.get(s)
      if (!v || !canVideo) return
      if (!v.frame) {
        const p = new URLSearchParams({
          autoplay: '1', mute: '1', controls: '0', playsinline: '1', rel: '0', disablekb: '1',
          iv_load_policy: '3', modestbranding: '1', enablejsapi: '1', start: String(v.start), fs: '0', cc_load_policy: '0',
          origin: location.origin,
        })
        const f = document.createElement('iframe')
        f.src = `https://www.youtube-nocookie.com/embed/${v.box.dataset.yt}?${p}`
        f.title = v.box.closest<HTMLElement>('.hero-c')?.dataset.videoTitle ?? ''
        f.tabIndex = -1
        f.allow = 'autoplay; encrypted-media'
        // 開始接收播放秒數；真的播到片段裡才淡入，避免先看到黑畫面與 YouTube 介面
        f.addEventListener('load', () => f.contentWindow?.postMessage(JSON.stringify({ event: 'listening', id: 1, channel: 'widget' }), '*'))
        v.box.appendChild(f)
        v.frame = f
      } else {
        cmd(v, 'playVideo')
      }
    }
    function pauseVideos(except?: HTMLElement) {
      vids.forEach((v, s) => {
        if (s === except) return
        conceal(v)
        cmd(v, 'pauseVideo')
      })
    }

    function show(n: number) {
      current = (n + slides.length) % slides.length
      slides.forEach((s, i) => {
        const on = i === current
        s.classList.toggle('is-active', on)
        if (on) s.removeAttribute('aria-hidden')
        else s.setAttribute('aria-hidden', 'true')
      })
      vids.forEach((v) => { v.played = false })
      pauseVideos(slides[current])
      if (!userPaused) playVideo(slides[current])
      dots.forEach((d, i) => (i === current ? d.setAttribute('aria-current', 'true') : d.removeAttribute('aria-current')))
    }
    function schedule() {
      window.clearTimeout(timer)
      if (userPaused || hover || document.hidden) return
      // 有背景影片、而且真的播起來的那一頁，停留到片段播完（最多 25 秒）；
      // 影片沒播起來（手機省電模式、瀏覽器擋自動播放）就照一般秒數換頁，不要對著靜態照片乾等
      const v = canVideo ? vids.get(slides[current]) : undefined
      const wait = v?.played && v.end > v.start ?Math.min(Math.max(interval, (v.end - v.start) * 1000), 25000) : interval
      timer = window.setTimeout(() => { show(current + 1); schedule() }, wait)
    }
    function setPaused(p: boolean) {
      userPaused = p
      // 減少動態時背景影片不播
      if (p) pauseVideos()
      else playVideo(slides[current])
      schedule()
    }

    dots.forEach((d) => d.addEventListener('click', () => { show(Number(d.dataset.go)); schedule() }))
    root.querySelectorAll<HTMLButtonElement>('.hero-arrow').forEach((b) =>
      b.addEventListener('click', () => { show(current + Number(b.dataset.step)); schedule() }))
    root.addEventListener('keydown', (e) => {
      if (e.key !== 'ArrowLeft' && e.key !== 'ArrowRight') return
      e.preventDefault()
      show(current + (e.key === 'ArrowRight' ? 1 : -1))
    })
    // 手機左右滑：水平移動超過 40px、且明顯比上下移動多才算，不影響上下捲動頁面
    let touchX = 0
    let touchY = 0
    root.addEventListener('touchstart', (e) => { touchX = e.touches[0].clientX; touchY = e.touches[0].clientY }, { passive: true })
    root.addEventListener('touchend', (e) => {
      const dx = e.changedTouches[0].clientX - touchX
      const dy = e.changedTouches[0].clientY - touchY
      if (Math.abs(dx) < 40 || Math.abs(dx) < Math.abs(dy) * 1.5) return
      show(current + (dx < 0 ? 1 : -1))
      schedule()
    }, { passive: true })
    // 只認真正的滑鼠：手機點一下也會觸發 mouseenter，卻永遠等不到 mouseleave，輪播就停住不動
    root.addEventListener('pointerenter', (e) => { if (e.pointerType === 'mouse') { hover = true; schedule() } })
    root.addEventListener('pointerleave', (e) => { if (e.pointerType === 'mouse') { hover = false; schedule() } })
    // 鍵盤聚焦才停（手機點圓點也會聚焦，不算）
    root.addEventListener('focusin', (e) => { if ((e.target as HTMLElement).matches?.(':focus-visible')) { hover = true; schedule() } })
    root.addEventListener('focusout', () => { hover = false; schedule() })
    document.addEventListener('visibilitychange', schedule)

    // 第一頁的背景影片等整頁載入完再開始，先看到照片，首頁不會因為影片變慢
    let ready = document.readyState === 'complete'
    const origPlay = playVideo
    playVideo = (s: HTMLElement) => { if (ready) origPlay(s) }
    if (!ready) window.addEventListener('load', () => window.setTimeout(() => {
      ready = true
      if (!userPaused && !document.hidden) origPlay(slides[current])
    }, 600), { once: true })

    setPaused(userPaused)
  })
</script>

<style>
  .hero-c { position: relative; min-height: min(80vh, 760px); overflow: hidden; background: var(--forest-deep); touch-action: pan-y; }
  .hero-slide {
    position: absolute; inset: 0; display: flex; align-items: center;
    opacity: 0; visibility: hidden; transition: opacity 1.2s ease, visibility 1.2s;
  }
  .hero-slide.is-active { opacity: 1; visibility: visible; position: relative; min-height: inherit; }
  .hero-slide :global(.hero-c-media) { position: absolute; inset: 0; }
  /* 背景影片：蓋滿整個主視覺（16:9 依容器比例放大裁切），稍微放大藏住 YouTube 邊角介面 */
  /* 退回照片時立刻消失（不讓 YouTube 的暫停圖示在淡出時露出來），開始播放時才慢慢淡入 */
  .hero-video { position: absolute; inset: 0; overflow: hidden; container-type: size; opacity: 0; transition: opacity 0.15s linear; pointer-events: none; }
  .hero-video.is-playing { opacity: 1; transition: opacity 1.2s ease; }
  .hero-video :global(iframe) {
    position: absolute; top: 50%; left: 50%; border: 0;
    width: max(100cqw, calc(100cqh * 16 / 9)); height: max(100cqh, calc(100cqw * 9 / 16));
    transform: translate(-50%, -50%) scale(1.18);
  }
  /* 直式畫面會看到影片全高，影片底部的字幕會跑出來：放大一點並往下移，把字幕裁掉 */
  @media (max-width: 900px) {
    .hero-video :global(iframe) { transform: translate(-50%, -50%) scale(1.4) translateY(3%); }
  }
  .hero-slide :global(.hero-c-media .photo-ph) { justify-content: flex-end; align-items: flex-end; padding: 1.2rem 1.5rem 4.5rem; }
  .hero-slide.tone-mist :global(.hero-c-media) { background: linear-gradient(140deg, #6A8794, var(--slate)); }
  .hero-slide.tone-clay :global(.hero-c-media) { background: linear-gradient(140deg, #A9774F, var(--clay-deep)); }
  .hero-slide.tone-leaf :global(.hero-c-media) { background: linear-gradient(140deg, #7A8752, var(--olive)); }
  .hero-slide :global(.hero-c-media .photo-ph) { color: rgba(255, 255, 255, 0.75); }
  /* 置中文字用均勻柔和的遮罩，換上照片後文字依然清楚 */
  .hero-c-shade { position: absolute; inset: 0; background: radial-gradient(ellipse at center, rgba(28, 46, 34, 0.5), rgba(28, 46, 34, 0.2) 75%); }
  .hero-c-inner { position: relative; text-align: center; color: #fff; padding-top: 4rem; padding-bottom: 5rem; }
  .hero-c-pre { font-size: clamp(1.5rem, 3.4vw, 2.4rem); font-weight: 700; letter-spacing: 0.3em; opacity: 0.95; }
  .hero-c-title {
    font-size: clamp(2rem, 5.4vw, 4rem); font-weight: 700; letter-spacing: 0.16em; line-height: 1.4;
    margin: 0.4rem auto 0; max-width: 18em;
  }
  .hero-c-title.size-md { font-size: clamp(1.35rem, 3.8vw, 2.8rem); max-width: 22em; letter-spacing: 0.12em; }
  .hero-c-title :global(.nw) { white-space: nowrap; }
  .hero-c-sub { text-wrap: balance; margin: 1.6rem auto 0; max-width: 32em; font-size: clamp(1rem, 1.6vw, 1.15rem); line-height: 2; letter-spacing: 0.12em; opacity: 0.95; }

  .hero-ctrl {
    position: absolute; left: 0; right: 0; bottom: 1.6rem; z-index: 2;
    display: flex; justify-content: center; align-items: center; gap: 1rem;
  }
  .hero-dots { display: flex; gap: 0.6rem; }
  .hero-dot {
    width: 12px; height: 12px; border-radius: 999px; border: 0; padding: 0; cursor: pointer;
    background: rgba(255, 255, 255, 0.5); transition: width 0.3s, background 0.3s;
  }
  .hero-dot[aria-current='true'] { width: 32px; background: #fff; }
  .hero-dot:focus-visible { outline: 2px solid #fff; outline-offset: 3px; }
  /* 圓點很小，手指點擊範圍往外放大 */
  .hero-dot { position: relative; }
  .hero-dot::before { content: ''; position: absolute; inset: -10px -4px; }

  /* 左右箭頭：電腦版常駐但低調，滑鼠移到主視覺上才變明顯；手機改用滑的，不顯示 */
  .hero-arrow {
    position: absolute; top: 50%; z-index: 2; transform: translateY(-50%);
    width: 52px; height: 52px; border-radius: 50%; border: 1px solid rgba(255, 255, 255, 0.45);
    background: rgba(28, 46, 34, 0.25); color: #fff; cursor: pointer; padding: 0;
    display: inline-flex; align-items: center; justify-content: center;
    opacity: 0.55; transition: opacity 0.25s, background 0.25s;
  }
  .hero-arrow.is-prev { left: clamp(0.8rem, 2.5vw, 2rem); }
  .hero-arrow.is-next { right: clamp(0.8rem, 2.5vw, 2rem); }
  .hero-c:hover .hero-arrow { opacity: 0.9; }
  .hero-arrow:hover { opacity: 1; background: rgba(28, 46, 34, 0.5); }
  .hero-arrow:focus-visible { opacity: 1; outline: 2px solid #fff; outline-offset: 3px; }
  .hero-arrow svg { width: 24px; height: 24px; fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }

  @media (max-width: 640px) {
    .hero-c { min-height: 520px; }
    .hero-arrow { display: none; }
    .hero-c-inner { padding-top: 4rem; padding-bottom: 5.5rem; }
    .hero-c-title { letter-spacing: 0.08em; }
    .hero-c-title.size-md { letter-spacing: 0.04em; }
  }
</style>
