---
// 主題頁：/themes/{slug}，首頁「我們怎麼一起學」的 01–03 點進來先到這裡，
// 多介紹一點這個主題，再列出相關活動與專欄文章。內容在後台「頁面文案 → 慢活共學主題＋學會活動類別」。
// 版面與活動頁、文章頁一致：電腦版左側列出三大主題。
import Base from '../layouts/Base.astro'
import PortableText from '../components/PortableText.astro'
import Photo from '../components/Photo.astro'
import EventCard from '../components/EventCard.astro'
import ArticleCard from '../components/ArticleCard.astro'
import SideList from '../components/SideList.astro'
import { sanity, Q, imageUrl } from '../lib/sanity'
import { getThemePages, themeTone } from '../lib/site'
import UntranslatedNote from '../components/UntranslatedNote.astro'
import { langOf, localizePath } from '../lib/i18n'
import { catLabel, t } from '../lib/ui'
import { categoryOf, getArticles } from '../lib/column'
import type { CmsEvent } from '../lib/events'

type ThemePage = {
  _key: string
  icon?: string
  title: string
  en?: string
  description?: string
  image?: { asset?: any; alt?: string }
  category?: string
  slug: string
  body?: any[]
  events?: (CmsEvent | null)[]
}

const lang = langOf(Astro.url.pathname)
const L = (href: string) => localizePath(lang, href)
const { slug } = Astro.params
const { themes: all, untranslated, enTranslated } = await getThemePages(lang)
const index = all.findIndex((x) => x.slug === slug)
const th = all[index] as ThemePage
const tone = themeTone(index)
const cover = imageUrl(th.image, 1600)
const events = (th.events ?? []).filter((e): e is CmsEvent => !!e?.slug)
const articles = th.category ? (await getArticles(lang)).filter((a) => a.category === th.category) : []
const shownArticles = articles.slice(0, 6)
const cat = th.category ? categoryOf(th.category) : undefined

const side = [{
  title: t(lang, 'theme.three'),
  items: all.map((x, i) => ({
    href: L(`/themes/${x.slug}`),
    title: `${String(i + 1).padStart(2, '0')}　${x.title}`,
    // 主題的英文名是中文頁的點綴；英文頁標題本身就是英文，不再重複
    meta: lang === 'zh' ? x.en : undefined,
    current: x.slug === th.slug,
  })),
}]
---
<Base title={th.title} description={th.description} ogImage={cover} translated={enTranslated}>
  <div class="page" id="page-theme">
    <UntranslatedNote show={untranslated} />
    <div class="container detail-layout">
      <SideList heading={t(lang, 'theme.section')} headingHref={L('/#learning')} label={t(lang, 'theme.three')} groups={side} />

      <div>
        <header class="detail-head">
          <div class="detail-narrow">
            <p class="crumbs"><a href={L('/')}>{t(lang, 'crumb.home')}</a> / <a href={L('/#learning')}>{t(lang, 'theme.three')}</a> / {th.title}</p>
            <p class="tp-num" aria-hidden="true">{String(index + 1).padStart(2, '0')}</p>
            {lang === 'zh' && th.en && <p class="tp-en">{th.en}</p>}
            <h1>{th.title}</h1>
            {th.description && <p class="tp-lead">{th.description}</p>}
          </div>
        </header>

        <article class="detail-narrow">
          <Photo src={cover} alt={th.image?.alt || t(lang, 'theme.photoAlt', { title: th.title })} tone={tone} icon={th.icon}
                 placeholder={t(lang, 'photo.placeholder')} class="tp-photo" eager />
          {th.body?.length ? <div class="detail-text rich-links"><PortableText value={th.body} /></div> : null}
        </article>

        {events.length > 0 && (
          <section class="tp-more" aria-labelledby="t-events">
            <div class="block-head">
              <h2 id="t-events" class="tp-h">{t(lang, 'theme.events')}</h2>
              <a class="text-link" href={L('/events#list')}>{t(lang, 'event.allLink')} →</a>
            </div>
            <div class="grid-2">{events.map((e) => <EventCard event={e} />)}</div>
          </section>
        )}

        {cat && (
          <section class="tp-more" aria-labelledby="t-articles">
            <div class="block-head">
              <h2 id="t-articles" class="tp-h">{t(lang, 'theme.articles')}</h2>
              {articles.length > 0 && <a class="text-link" href={L(`/column?cat=${cat.value}`)}>{t(lang, 'theme.allCat', { cat: catLabel(cat.value, lang) })} →</a>}
            </div>
            {shownArticles.length > 0 ? (
              <div class="grid-2">{shownArticles.map((a) => <ArticleCard article={a} />)}</div>
            ) : (
              <p class="tp-empty rich-links">{t(lang, 'theme.empty1')}<a href={L('/contact')}>{t(lang, 'theme.emptyLink')}</a>{t(lang, 'theme.empty2')}</p>
            )}
          </section>
        )}
      </div>
    </div>
  </div>
</Base>

<style>
  .tp-num { font-family: 'Cormorant Garamond', serif; font-style: italic; font-weight: 700; font-size: clamp(2.6rem, 5vw, 3.6rem); line-height: 1; color: var(--forest); }
  .tp-en { margin-top: 0.4rem; font-family: 'Cormorant Garamond', serif; font-style: italic; font-size: 1.15rem; color: var(--ink-soft); letter-spacing: 0.04em; }
  .tp-lead { margin-top: 1rem; font-size: 1.1rem; line-height: 2; color: var(--ink-soft); }
  .detail-narrow :global(.tp-photo) { aspect-ratio: 16 / 9; border-radius: var(--radius); overflow: hidden; margin-bottom: 2.4rem; }
  .detail-narrow :global(.tp-photo img) { width: 100%; height: 100%; object-fit: cover; }
  .tp-more { margin-top: clamp(3rem, 6vw, 4.5rem); padding-top: 2.4rem; border-top: 1px solid var(--line); }
  .tp-h { font-size: clamp(1.3rem, 2.4vw, 1.6rem); font-weight: 700; color: var(--ink); letter-spacing: 0.1em; }
  .grid-2 { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: clamp(1.25rem, 2vw, 1.75rem); }
  .tp-empty { font-size: 1rem; line-height: 2; color: var(--ink-soft); }
  @media (max-width: 640px) { .grid-2 { grid-template-columns: minmax(0, 1fr); } }
</style>
