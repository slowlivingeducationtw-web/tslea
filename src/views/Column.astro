---
// 慢活專欄列表：版型與活動頁一致（頁首→分類篩選→卡片）。
// 上方文字在後台「頁面文案 → 慢活專欄」，文章在「內容 → 專欄文章」。
import Base from '../layouts/Base.astro'
import PortableText from '../components/PortableText.astro'
import ArticleCard from '../components/ArticleCard.astro'
import { fetchOne, Q } from '../lib/sanity'
import { CATEGORIES, getColumnItems, inCategory, seriesOf, type SeriesDef } from '../lib/column'
import UntranslatedNote from '../components/UntranslatedNote.astro'
import { isTranslated, langOf, localize, localizePath } from '../lib/i18n'
import { catLabel, seriesName, t } from '../lib/ui'

type Page = { title: string; lead?: string; seoDescription?: string; emptyText?: any[]; series?: SeriesDef[] }
// 專欄文章＋活動回顧（活動回顧是一個分類，點了回到原本的活動頁）
const lang = langOf(Astro.url.pathname)
const L = (href: string) => localizePath(lang, href)
const [articles, raw] = await Promise.all([getColumnItems(lang), fetchOne<Page>(Q.columnPage, {}, '慢活專欄頁面')])
const page = localize(raw, lang)
// 篩選按鈕只列有文章的分類，避免點了是空的
const used = CATEGORIES.filter((c) => articles.some((a) => inCategory(a, c.value)))
// 第二排：依系列（後台文章的「系列名稱」，例：每月一字）；選了系列時列表上方顯示該系列的小簡介
// 和分類同名的系列（慢活小語）不另外列按鈕，免得出現兩顆一樣的
const series = seriesOf(articles, page.series).filter((s) => !CATEGORIES.some((c) => c.label === s.label))
---
<Base title={page.title} description={page.seoDescription} translated={isTranslated(localize(raw, 'en'))}>
  <div class="page" id="page-column">
    <UntranslatedNote show={!!page._untranslated} />
    <header class="page-head">
      <div class="container">
        <p class="crumbs"><a href={L('/')}>{t(lang, 'crumb.home')}</a> / {page.title}</p>
        <h1>{page.title}</h1>
        {page.lead && <p class="lead">{page.lead}</p>}
      </div>
    </header>

    {(used.length > 1 || series.length > 0) && (
      <nav class="type-filter" id="list" aria-label={t(lang, 'column.filterLabel')}>
        <div class="container type-filter-inner">
          <span class="type-filter-label">{t(lang, 'column.byCategory')}</span>
          <button type="button" class="type-btn is-on" data-type="" aria-pressed="true">{t(lang, 'events.all')}</button>
          {used.map((c) => (
            <button type="button" class="type-btn" data-type={c.value} aria-pressed="false">{catLabel(c.value, lang)}</button>
          ))}
        </div>
        {series.length > 0 && (
          <div class="container type-filter-inner series-row">
            <span class="type-filter-label">{t(lang, 'column.bySeries')}</span>
            {series.map((s) => (
              <button type="button" class="type-btn series-btn" data-series={s.value} aria-pressed="false">{seriesName(s.value, lang, true)}</button>
            ))}
          </div>
        )}
      </nav>
    )}

    <section class="block block-alt" aria-label={t(lang, 'column.listLabel')}>
      <div class="container">
        {series.filter((s) => s.intro).map((s) => (
          <div class="series-intro" data-intro={s.value} hidden>
            <p class="series-intro-label">{seriesName(s.value, lang, true)}</p>
            <h2 class="series-intro-title">{s.title || seriesName(s.value, lang, true)}</h2>
            <p class="series-intro-text">{s.intro}</p>
          </div>
        ))}
        {articles.length > 0 ? (
          <div class="grid-3" id="posts">{articles.map((a) => <ArticleCard article={a} />)}</div>
        ) : null}
        <div class="col-empty rich-links" id="colEmpty" hidden={articles.length > 0}>
          {page.emptyText ? <PortableText value={page.emptyText} /> : <p>{t(lang, 'column.empty')}</p>}
        </div>
      </div>
    </section>
  </div>

  <script>
    // 依分類或依系列篩選（一次只用一種）：按鈕或網址 ?cat=… / ?series=…
    // （首頁主題、選單子項目、文章頁的系列名稱會用這種網址連進來）
    const btns = [...document.querySelectorAll<HTMLButtonElement>('.type-btn')]
    const cards = [...document.querySelectorAll<HTMLElement>('#posts > [data-type]')]
    const empty = document.getElementById('colEmpty')
    function apply(cat: string, series = '') {
      btns.forEach((b) => {
        const on = b.dataset.series !== undefined ? b.dataset.series === series : !series && b.dataset.type === cat
        b.classList.toggle('is-on', on)
        b.setAttribute('aria-pressed', String(on))
      })
      let shown = 0
      cards.forEach((c) => {
        // data-type 可能有好幾個分類（活動回顧＋生態永續），用空白隔開
        c.hidden = series ? c.dataset.series !== series : !!cat && !(c.dataset.type ?? '').split(' ').includes(cat)
        if (!c.hidden) shown++
      })
      if (empty) empty.hidden = shown > 0
      document.querySelectorAll<HTMLElement>('[data-intro]').forEach((el) => (el.hidden = el.dataset.intro !== series))
      const url = new URL(location.href)
      url.searchParams.delete('cat')
      url.searchParams.delete('series')
      if (series) url.searchParams.set('series', series)
      else if (cat) url.searchParams.set('cat', cat)
      history.replaceState(null, '', url)
    }
    btns.forEach((b) =>
      b.addEventListener('click', () => (b.dataset.series !== undefined ? apply('', b.dataset.series) : apply(b.dataset.type ?? ''))),
    )
    const params = new URLSearchParams(location.search)
    if (params.get('series')) apply('', params.get('series')!)
    else if (params.get('cat')) apply(params.get('cat')!)
  </script>
</Base>

<style>
  /* 系列那排緊貼分類那排；未選取時用淺底，和分類按鈕分得出來 */
  .series-row { padding-top: 0; }
  .series-btn:not(.is-on) { background: var(--forest-pale); border-color: transparent; }
  .series-intro { margin-bottom: 2rem; padding: 1.4rem 1.6rem; background: #fff; border: 1px solid var(--line); border-left: 4px solid var(--forest); border-radius: var(--radius); }
  .series-intro-label { font-size: 0.85rem; letter-spacing: 0.12em; color: var(--ink-soft); }
  .series-intro-title { margin-top: 0.3rem; font-size: 1.3rem; font-weight: 700; letter-spacing: 0.06em; color: var(--ink); }
  .series-intro-text { margin-top: 0.6rem; font-size: 1rem; line-height: 1.9; color: var(--ink-soft); }
  .col-empty { padding: 2rem 0; text-align: center; font-size: 1rem; line-height: 2; color: var(--ink-soft); }
</style>
