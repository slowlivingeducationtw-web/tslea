---
import Base from '../layouts/Base.astro'
import PortableText from '../components/PortableText.astro'
import { fetchOne, Q } from '../lib/sanity'
import { getSettings, cardHref } from '../lib/site'
import UntranslatedNote from '../components/UntranslatedNote.astro'
import { isTranslated, langOf, localize, localizePath } from '../lib/i18n'
import { t } from '../lib/ui'

// 全部內容在後台「頁面文案 → 加入我們」。
// 卡片按鈕：有填「按鈕連結」（例如日後的線上表單）就用它，沒有就寄信給學會並帶入主旨。
type Card = {
  _key: string
  anchor?: string
  icon?: string
  title: string
  text?: string
  ctaLabel: string
  href?: string
  emailSubject?: string
  note?: string
}
type Page = { title: string; lead?: string; seoDescription?: string; cards?: Card[]; footnote?: any[] }
const lang = langOf(Astro.url.pathname)
const L = (href: string) => localizePath(lang, href)
const [raw, settings] = await Promise.all([fetchOne<Page>(Q.joinPage, {}, '加入我們頁面'), getSettings(lang)])
const page = localize(raw, lang)
---
<Base
  title={page.title}
  description={page.seoDescription}
  translated={isTranslated(localize(raw, 'en'))}
>
  <div class="page" id="page-join">
    <UntranslatedNote show={!!page._untranslated} />
    <header class="page-head">
      <div class="container">
        <p class="crumbs"><a href={L('/')}>{t(lang, 'crumb.home')}</a> / {page.title}</p>
        <h1>{page.title}</h1>
        {page.lead && <p class="lead">{page.lead}</p>}
      </div>
    </header>

    <section class="block">
      <div class="container">
        <ul class="join-list">
          {(page.cards ?? []).map((c) => (
            <li class="card join-card" id={c.anchor}>
              <div class="card-body">
                <span class="join-icon" aria-hidden="true">{c.icon}</span>
                <h2 class="card-title">{c.title}</h2>
                {c.text && <p class="card-text">{c.text}</p>}
                <div class="card-foot">
                  <a class="btn btn-solid btn-sm" href={L(cardHref(c, settings.email))}>{c.ctaLabel}</a>
                  {c.note && <span class="join-pending">{c.note}</span>}
                </div>
              </div>
            </li>
          ))}
        </ul>
        {page.footnote && <div class="join-more rich-links"><PortableText value={page.footnote} /></div>}
      </div>
    </section>
  </div>
</Base>

<style>
  .join-list { list-style: none; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: clamp(1.25rem, 2vw, 2rem); }
  @media (max-width: 720px) { .join-list { grid-template-columns: minmax(0, 1fr); } }
  .join-card { scroll-margin-top: calc(var(--header-h) + 1.5rem); }
  .join-card:target { outline: 3px solid var(--forest); outline-offset: 3px; }
  .join-icon { font-size: 2rem; }
  .join-pending { font-size: 0.78rem; color: var(--ink-soft); letter-spacing: 0.05em; }
  .join-more { margin-top: 2.5rem; font-size: 0.98rem; color: var(--ink-soft); line-height: 2; }
</style>
