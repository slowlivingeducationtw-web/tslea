---
import Base from '../layouts/Base.astro'
import EventCard from '../components/EventCard.astro'
import { getEvents, badgeOf, STATUS_FILTERS } from '../lib/events'
import { fetchOne, Q } from '../lib/sanity'
import FormatList from '../components/FormatList.astro'
import { getSettings, getThemes, getActivityTypes, typeTone } from '../lib/site'
import UntranslatedNote from '../components/UntranslatedNote.astro'
import { isTranslated, langOf, localize, localizePath } from '../lib/i18n'
import { t } from '../lib/ui'

// 全站唯一的活動清單；首頁「近期活動」只是這裡「即將舉行／持續進行」的前三筆
// 頁面文字在後台「頁面文案 → 活動」，活動本身在「內容 → 活動資訊」
// 一個活動一頁：清單是全部活動，還沒結束的在前、已結束（含活動回顧）的在後
const lang = langOf(Astro.url.pathname)
const L = (href: string) => localizePath(lang, href)
const { list } = await getEvents(lang)
type Page = {
  title: string
  lead?: string
  seoDescription?: string
  facebookNote?: boolean
  currentTitle?: string
  emptyText?: string
}
// 「學會活動類別」（後台「內容 → 學會活動類別」）是活動的分類標籤，
// 下方清單可以依類別篩選（/events?type=…）。
const [raw, settings, learning, types] = await Promise.all([
  fetchOne<Page>(Q.eventsPage, {}, '活動頁面'),
  getSettings(lang),
  getThemes(lang),
  getActivityTypes(lang),
])
const page = localize(raw, lang)
// 第二排：依狀態（報名中、活動回顧、已結束……），只列目前真的有活動的狀態
const statuses = STATUS_FILTERS.filter((f) => list.some((e) => (f.kinds as readonly string[]).includes(badgeOf(e, lang)?.kind ?? '')))


---
<Base
  title={page.title}
  description={page.seoDescription}
  translated={isTranslated(localize(raw, 'en'))}
>
  <div class="page" id="page-events">
    <UntranslatedNote show={!!page._untranslated} />
    <header class="page-head">
      <div class="container">
        <p class="crumbs"><a href={L('/')}>{t(lang, 'crumb.home')}</a> / {page.title}</p>
        <h1>{page.title}</h1>
        <p class="lead">
          {page.lead}
          {page.facebookNote && settings.facebook && (
            <>{t(lang, 'events.fbNote')}
            <a class="text-link" href={settings.facebook} target="_blank" rel="noopener">{t(lang, 'footer.facebook')}</a>{t(lang, 'events.period')}</>
          )}
        </p>
      </div>
    </header>

    {types.length ? (
      <section class="block" id="types" aria-labelledby="types-title">
        <div class="container">
          <h2 id="types-title" class="block-title events-h">{learning.formatsTitle || t(lang, 'events.formats')}</h2>
          <FormatList formats={types} />
        </div>
      </section>
    ) : null}


    {(types.length > 0 || statuses.length > 1) && (
      <nav class="type-filter" id="list" aria-label={t(lang, 'events.filterLabel')}>
        <div class="container type-filter-inner">
          <span class="type-filter-label">{t(lang, 'events.byType')}</span>
          <button type="button" class="type-btn is-on" data-type="" aria-pressed="true">{t(lang, 'events.all')}</button>
          {types.map((ty) => (
            <button type="button" class={`type-btn tone-${typeTone(types, ty.slug)}`} data-type={ty.slug} aria-pressed="false">{ty.title}</button>
          ))}
        </div>
        {statuses.length > 1 && (
          <div class="container type-filter-inner status-row">
            <span class="type-filter-label">{t(lang, 'events.byStatus')}</span>
            {statuses.map((f) => (
              <button type="button" class="type-btn status-btn" data-status={f.kinds.join(',')} aria-pressed="false">{t(lang, f.key)}</button>
            ))}
          </div>
        )}
      </nav>
    )}

    <section class="block block-alt filterable" id="current" aria-labelledby="current-title">
      <div class="container">
        <h2 id="current-title" class="block-title events-h">{page.currentTitle || t(lang, 'events.currentTitle')}</h2>
        {/* 選了某個活動類別時，列表上方顯示該類別的說明（用 data-intro，不能用 data-type，否則會被當成活動計數） */}
        {types.filter((ty) => ty.description).map((ty) => (
          <div class="type-intro" data-intro={ty.slug} hidden>
            <h3 class="type-intro-title">{ty.title}</h3>
            <p class="type-intro-text">{ty.description}</p>
          </div>
        ))}
        {list.length > 0 ? (
          <div class="grid-3">{list.map((e) => <EventCard event={e} />)}</div>
        ) : (
          <p class="events-empty">{page.emptyText || t(lang, 'events.empty')}</p>
        )}
        <p class="events-empty filter-empty" hidden>{t(lang, 'events.filterEmpty')}</p>
        {/* 選單的「報名中」等狀態連結：沒有符合的活動時說明一下，並指向粉專 */}
        <p class="events-empty status-empty" hidden>
          {page.emptyText || t(lang, 'events.empty')}
          {settings.facebook && (
            <>{t(lang, 'events.fbLatest')}<a class="text-link" href={settings.facebook} target="_blank" rel="noopener">{t(lang, 'footer.facebook')}</a>{t(lang, 'events.period')}</>
          )}
        </p>
      </div>
    </section>


  </div>

  <script>
    // 依活動類別或依狀態篩選（一次只用一種）：上方按鈕、「學會活動」的圖示、網址 ?type=… / ?status=… 都會套用
    const btns = [...document.querySelectorAll<HTMLButtonElement>('.type-btn')]
    function apply(type: string, status = '') {
      const kinds = status ? status.split(',') : []
      btns.forEach((b) => {
        const on = b.dataset.status !== undefined ? b.dataset.status === status : !status && b.dataset.type === type
        b.classList.toggle('is-on', on)
        b.setAttribute('aria-pressed', String(on))
      })
      document.querySelectorAll<HTMLElement>('.filterable').forEach((sec) => {
        const items = [...sec.querySelectorAll<HTMLElement>('[data-type]')]
        let shown = 0
        items.forEach((el) => {
          const hit = status ? kinds.includes(el.dataset.status ?? '') : !type || el.dataset.type === type
          ;(el.closest('li, .grid-3 > *') as HTMLElement ?? el).hidden = !hit
          if (hit) shown++
        })
        const none = (!!type || !!status) && shown === 0
        // 「即將舉行」留著並說明沒有；回顧與已辦理沒有符合的就整區收起，避免一長串「沒有」
        if (sec.id === 'current') {
          const empty = sec.querySelector<HTMLElement>('.filter-empty')
          if (empty) empty.hidden = !(none && items.length > 0 && !status)
          const statusEmpty = sec.querySelector<HTMLElement>('.status-empty')
          if (statusEmpty) statusEmpty.hidden = !(none && !!status)
        } else sec.hidden = none
      })
      document.querySelectorAll<HTMLElement>('[data-intro]').forEach((el) => (el.hidden = !!status || el.dataset.intro !== type))
      const url = new URL(location.href)
      url.searchParams.delete('type')
      url.searchParams.delete('status')
      if (status) url.searchParams.set('status', status)
      else if (type) url.searchParams.set('type', type)
      history.replaceState(null, '', url)
    }
    btns.forEach((b) =>
      b.addEventListener('click', () => (b.dataset.status !== undefined ? apply('', b.dataset.status) : apply(b.dataset.type ?? ''))),
    )
    // 同一頁的「學會活動」圖示：直接篩選並捲到清單，不重新載入
    document.querySelectorAll<HTMLAnchorElement>('.format-link').forEach((a) =>
      a.addEventListener('click', (ev) => {
        ev.preventDefault()
        apply(a.dataset.type ?? '')
        document.getElementById('list')?.scrollIntoView({ behavior: 'smooth' })
      }),
    )
    const params = new URLSearchParams(location.search)
    const wantStatus = params.get('status')
    const want = params.get('type')
    // 狀態連結即使目前沒有那種活動（沒有按鈕）也照樣篩選，顯示「目前沒有」的說明
    if (wantStatus) apply('', wantStatus)
    else if (want && btns.some((b) => b.dataset.type === want)) apply(want)
  </script>
</Base>

<style>
  .events-h { margin-bottom: 2rem; }
  /* 狀態那排緊貼類別那排；未選取時用淺底，和類別按鈕分得出來 */
  .status-row { padding-top: 0; }
  .status-btn:not(.is-on) { background: var(--forest-pale); border-color: transparent; }
  .type-intro { margin-bottom: 2rem; padding: 1.4rem 1.6rem; background: #fff; border: 1px solid var(--line); border-left: 4px solid var(--forest); border-radius: var(--radius); }
  .type-intro-title { font-size: 1.2rem; font-weight: 700; letter-spacing: 0.08em; color: var(--ink); }
  .type-intro-text { margin-top: 0.5rem; font-size: 1rem; line-height: 1.9; color: var(--ink-soft); }
  .events-empty { font-size: 1rem; color: var(--ink-soft); line-height: 1.9; }
</style>
