---
// 專欄文章頁：/column/{slug}，內容在後台「內容 → 專欄文章」。
// 版面與活動頁一致：電腦版左側依分類列出所有文章，手機版改看頁尾「其他文章」。
import Base from '../layouts/Base.astro'
import PortableText from '../components/PortableText.astro'
import ArticleCard from '../components/ArticleCard.astro'
import SideList, { type SideGroup } from '../components/SideList.astro'
import { sanity, Q, imageUrl, imageDims, fetchOne } from '../lib/sanity'
import { CATEGORIES, categoryOf, dateText, getArticles, getColumnItems, inCategory, type SeriesDef } from '../lib/column'
import UntranslatedNote from '../components/UntranslatedNote.astro'
import { displayName, isTranslated, langOf, localize, localizePath } from '../lib/i18n'
import { catLabel, seriesName, t } from '../lib/ui'

const { slug } = Astro.params
const lang = langOf(Astro.url.pathname)
const L = (href: string) => localizePath(lang, href)
const raw = await sanity.fetch(Q.article, { slug })
if (!raw) throw new Error(`Sanity 找不到 slug 為 "${slug}" 的文章`)
const a = localize(raw, lang)
const translated = isTranslated(localize(raw, 'en'))

const site = 'https://slowlivingeducation.org'
const cover = imageUrl(a.cover?.image, 1600)
const coverDims = imageDims(a.cover?.image)
const cat = categoryOf(a.category)
const [all, items, columnPage] = await Promise.all([
  getArticles(lang),
  getColumnItems(lang), // 左側列表多列「活動回顧」，點了回到活動頁
  fetchOne<{ series?: SeriesDef[] }>(Q.columnPage, {}, '慢活專欄頁面').then((p) => localize(p, lang)),
])

// 左側列表：依分類分組（新的在前，含活動回顧），每組最多 8 篇，目前這篇一定列出
const SIDE_MAX = 8
const side: SideGroup[] = CATEGORIES.map((c) => {
  const inCat = items.filter((x) => inCategory(x, c.value))
  const shown = inCat.slice(0, SIDE_MAX)
  const self = inCat.find((x) => !x.href && x.slug === a.slug)
  if (self && !shown.includes(self)) shown.push(self)
  return {
    title: catLabel(c.value, lang),
    items: shown.map((x) => ({
      href: L(x.href ?? `/column/${x.slug}`),
      title: x.title,
      meta: dateText(x.publishedAt),
      current: !x.href && x.slug === a.slug,
    })),
    moreHref: inCat.length > shown.length ? L(`/column?cat=${c.value}`) : undefined,
  }
}).filter((g) => g.items.length > 0)

// 同系列：依日期排，文末給上一篇／下一篇，頁尾列出同系列其他文章（新的在前，最多六篇）
const seriesShort = seriesName(a.series, lang, true)
const seriesDef = columnPage.series?.find((d) => d.name === a.series)
const seriesHref = a.series ? L(`/column?series=${encodeURIComponent(a.series)}`) : ''
const inSeries = a.series ? all.filter((x) => x.series === a.series).sort((x, y) => x.publishedAt.localeCompare(y.publishedAt)) : []
const at = inSeries.findIndex((x) => x.slug === a.slug)
const prev = at > 0 ? inSeries[at - 1] : undefined
const next = at >= 0 ? inSeries[at + 1] : undefined
const siblings = inSeries.filter((x) => x.slug !== a.slug).reverse().slice(0, 6)

// 頁尾「其他文章」：不重複同系列，同分類優先，最多三篇
const others = all.filter((x) => x.slug !== a.slug && !siblings.includes(x))
const more = [...others.filter((x) => x.category === a.category), ...others.filter((x) => x.category !== a.category)].slice(0, 3)

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: a.title,
  description: a.excerpt,
  datePublished: a.publishedAt,
  image: cover,
  author: { '@type': 'Person', name: a.author && displayName(a.author, lang) },
  publisher: {
    '@type': 'Organization',
    name: t(lang, 'org.name'),
    logo: { '@type': 'ImageObject', url: `${site}/images/logo.png` },
  },
  inLanguage: lang === 'zh' ? 'zh-Hant-TW' : 'en',
  isPartOf: { '@type': 'Blog', name: t(lang, 'column.name'), url: `${site}${L('/column')}` },
  mainEntityOfPage: { '@type': 'WebPage', '@id': `${site}${L(`/column/${a.slug}`)}` },
  keywords: (a.tags || []).join(t(lang, 'list.sep')),
}
---
<Base title={a.title} description={a.excerpt} ogImage={cover} jsonLd={jsonLd} translated={translated}>
  <div class="page" id="page-article" data-cat={a.category}>
    <UntranslatedNote show={!!a._untranslated} />
    <div class="container detail-layout">
      <SideList heading={t(lang, 'column.name')} headingHref={L('/column')} label={t(lang, 'column.allArticles')} groups={side} />

      <div>
        <header class="detail-head">
          <div class="detail-narrow">
            <p class="crumbs"><a href={L('/')}>{t(lang, 'crumb.home')}</a> / <a href={L('/column')}>{t(lang, 'column.name')}</a> / {a.title}</p>
            <p class="detail-badges">
              <a class={`chip tone-${cat.tone}`} href={L(`/column?cat=${cat.value}`)}>{catLabel(cat.value, lang)}</a>
              {a.series && <a class="art-series" href={seriesHref}>{seriesName(a.series, lang)}</a>}
            </p>
            <h1>{a.title}</h1>
            <dl class="detail-facts">
              {a.author && <div><dt>{t(lang, 'article.author')}</dt><dd>{displayName(a.author, lang)}</dd></div>}
              <div><dt>{t(lang, 'article.date')}</dt><dd>{dateText(a.publishedAt)}</dd></div>
            </dl>
          </div>
        </header>

        <article class="detail-narrow">
          {cover && (
            <figure class="detail-cover">
              <img src={cover} alt={a.cover?.alt || a.title} width={coverDims?.width} height={coverDims?.height}
                   loading="eager" decoding="async" />
              {a.cover?.caption && <figcaption>{a.cover.caption}</figcaption>}
            </figure>
          )}

          <div class="detail-text rich-links"><PortableText value={a.body} /></div>

          {a.tags?.length > 0 && (
            <ul class="art-tags" aria-label={t(lang, 'article.tags')}>{a.tags.map((tag: string) => <li>#{tag}</li>)}</ul>
          )}

          {a.links?.length > 0 && (
            <ul class="detail-links">
              {a.links.map((l: any) => <li><a class="text-link" href={L(l.url)} target="_blank" rel="noopener">{l.title} →</a></li>)}
            </ul>
          )}

          {(prev || next) && (
            <nav class="series-nav" aria-label={t(lang, 'article.seriesNav', { series: seriesShort })}>
              {prev && (
                <a class="series-step" href={L(`/column/${prev.slug}`)} rel="prev">
                  <span class="series-step-label">{t(lang, 'article.prev', { series: seriesShort })}</span>
                  <span class="series-step-title">{prev.title}</span>
                </a>
              )}
              {next && (
                <a class="series-step is-next" href={L(`/column/${next.slug}`)} rel="next">
                  <span class="series-step-label">{t(lang, 'article.next', { series: seriesShort })}</span>
                  <span class="series-step-title">{next.title}</span>
                </a>
              )}
            </nav>
          )}

          {a.author && (
            <aside class="art-author" aria-label={t(lang, 'article.aboutAuthor')}>
              <span class={`art-avatar tone-${cat.tone}`} aria-hidden="true">{a.author.initial || displayName(a.author, lang).slice(0, 1)}</span>
              <div>
                <p class="art-author-name">{displayName(a.author, lang)}</p>
                {a.author.title && <p class="art-author-title">{a.author.title}</p>}
              </div>
            </aside>
          )}
        </article>
      </div>
    </div>

    {siblings.length > 0 && (
      <section class="block detail-series" aria-labelledby="series-title">
        <div class="container">
          <div class="block-head">
            <div>
              <h2 id="series-title" class="block-title">{t(lang, 'article.sameSeries', { series: seriesDef?.title || seriesShort })}</h2>
              {seriesDef?.intro && <p class="block-sub series-sub">{seriesDef.intro}</p>}
            </div>
            <a class="text-link" href={seriesHref}>{t(lang, 'article.wholeSeries')} →</a>
          </div>
          <div class="grid-3">{siblings.map((x) => <ArticleCard article={x} />)}</div>
        </div>
      </section>
    )}

    {more.length > 0 && (
      <section class="block block-alt detail-more" aria-labelledby="more-title">
        <div class="container">
          <div class="block-head">
            <h2 id="more-title" class="block-title">{t(lang, 'article.others')}</h2>
            <a class="text-link" href={L('/column')}>{t(lang, 'article.allLink')} →</a>
          </div>
          <div class="grid-3">{more.map((x) => <ArticleCard article={x} />)}</div>
        </div>
      </section>
    )}
  </div>
</Base>

<style>
  .art-series { font-size: 0.88rem; color: var(--ink-soft); letter-spacing: 0.06em; text-decoration: none; }
  .art-series:hover { color: var(--forest); text-decoration: underline; }
  .series-nav { display: grid; grid-template-columns: 1fr 1fr; gap: 0.8rem; margin-top: 2.4rem; }
  .series-step { display: flex; flex-direction: column; gap: 0.3rem; padding: 1rem 1.2rem; background: #fff; border: 1px solid var(--line); border-radius: var(--radius); text-decoration: none; color: var(--ink); }
  .series-step:hover { border-color: var(--forest); }
  .series-step.is-next { text-align: right; grid-column: 2; }
  .series-step-label { font-size: 0.85rem; color: var(--forest); letter-spacing: 0.06em; font-weight: 600; }
  .series-step-title { font-size: 0.95rem; line-height: 1.6; }
  @media (max-width: 640px) {
    .series-nav { grid-template-columns: 1fr; }
    .series-step.is-next { grid-column: auto; }
  }
  .series-sub { max-width: 46em; line-height: 1.9; }
  .art-tags { list-style: none; display: flex; flex-wrap: wrap; gap: 0.4rem 0.9rem; margin-top: 2rem; font-size: 0.9rem; color: var(--ink-soft); }
  .art-author { display: flex; gap: 1rem; align-items: center; margin-top: 2.4rem; padding: 1.2rem 1.4rem; background: #fff; border: 1px solid var(--line); border-radius: var(--radius); }
  .art-avatar { flex: none; width: 52px; height: 52px; border-radius: 50%; display: inline-flex; align-items: center; justify-content: center; font-weight: 700; font-size: 1.2rem; color: var(--ink); }
  .art-avatar.tone-mist { background: var(--mist); }
  .art-avatar.tone-clay { background: var(--clay); }
  .art-avatar.tone-leaf { background: var(--forest-pale); }
  .art-avatar.tone-forest { background: var(--forest); color: #fff; }
  .art-author-name { font-weight: 700; color: var(--ink); }
  .art-author-title { margin-top: 0.15rem; font-size: 0.92rem; color: var(--ink-soft); line-height: 1.7; }
</style>
